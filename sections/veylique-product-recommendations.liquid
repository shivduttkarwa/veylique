{% comment %}
  Product recommendations — "You may also like" on the product page.

  On first paint the section renders an empty shell; the deferred fetch below
  reloads this section through the product recommendations endpoint
  (Section Rendering API), which populates the `recommendations` object with
  products related to the current one. This is Shopify's sanctioned pattern —
  recommendations are only computed on that endpoint.

  https://shopify.dev/docs/storefronts/themes/product-merchandising/recommendations
{% endcomment %}

<div
  class="veylique-recommendations"
  data-veylique-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.max_products }}&intent=related"
>
  {% if recommendations.performed? and recommendations.products_count > 0 %}
    <section class="veylique-page veylique-section" aria-labelledby="VeyliqueRecsTitle-{{ section.id }}">
      <div class="veylique-container">
        <div class="veylique-section-head">
          <div>
            <p class="veylique-kicker">{{ section.settings.kicker | escape }}</p>
            <h2 id="VeyliqueRecsTitle-{{ section.id }}" class="veylique-section-title">{{ section.settings.heading | escape }}</h2>
          </div>
        </div>

        <div class="veylique-card-grid" style="--columns: {{ section.settings.columns_desktop }}">
          {% for recommended_product in recommendations.products %}
            <div>
              {% render 'veylique-product-card', product: recommended_product %}
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}
</div>

{% javascript %}
  (function () {
    function init(container) {
      if (!container || container.dataset.loaded) return;
      var url = container.dataset.url;
      if (!url) return;

      var load = function () {
        container.dataset.loaded = 'true';
        fetch(url)
          .then(function (response) { return response.text(); })
          .then(function (text) {
            var html = document.createElement('div');
            html.innerHTML = text;
            var fresh = html.querySelector('[data-veylique-recommendations]');
            if (fresh && fresh.innerHTML.trim().length) {
              container.innerHTML = fresh.innerHTML;
            }
          })
          .catch(function () { /* leave the shell empty on network failure */ });
      };

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            load();
          });
        }, { rootMargin: '400px 0px' });
        observer.observe(container);
      } else {
        load();
      }
    }

    document.querySelectorAll('[data-veylique-recommendations]').forEach(init);

    document.addEventListener('shopify:section:load', function (event) {
      init(event.target.querySelector('[data-veylique-recommendations]'));
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.veylique-product-recommendations.name",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.veylique-product-recommendations.settings.kicker.label",
      "default": "Keep exploring"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.veylique-product-recommendations.settings.heading.label",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:sections.veylique-product-recommendations.settings.max_products.label",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.veylique-featured-products.settings.columns_desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:sections.veylique-product-recommendations.presets.name"
    }
  ]
}
{% endschema %}
