  /* ---- Lightbox & size guide dialogs ---- */
  .veylique-pdp-lightbox,
  .veylique-pdp-sizeguide {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
