{% comment %}
  Product detail page — editorial gallery (scroll-snap slides, vertical thumb
  rail, lightbox zoom), variant-aware buy box (color dot swatches, size guide,
  live stock indicator, quantity, AJAX add-to-cart), trust strip, share, and
  details accordions. A sticky add-to-cart bar appears on mobile once the main
  actions scroll out of view.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
  assign has_media = false
  if product.media.size > 0
    assign has_media = true
  endif

  assign rating_value = 0
  assign rating_count = 0
  if product.metafields.reviews.rating != blank
    assign rating_value = product.metafields.reviews.rating.value | round: 1
    assign rating_count = product.metafields.reviews.rating_count | default: 0
  endif

  assign is_new = false
  if product.available and on_sale == false
    assign new_cutoff = 'now' | date: '%s' | minus: 2592000
    assign published = product.published_at | date: '%s' | plus: 0
    if published > new_cutoff
      assign is_new = true
    endif
  endif
%}

<section class="veylique-pdp full-width" data-veylique-product>
  <div class="veylique-pdp-inner">
    <nav class="veylique-pdp-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
      <span aria-hidden="true">/</span>
      {% if collection %}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span aria-hidden="true">/</span>
      {% endif %}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="veylique-pdp-grid">
      {% comment %} ---------- Gallery ---------- {% endcomment %}
      <div class="veylique-pdp-gallery">
        {% if product.media.size > 1 %}
          <div class="veylique-pdp-rail" role="list" data-pdp-thumbs>
            {% for media in product.media %}
              <button
                type="button"
                class="veylique-pdp-thumb{% if forloop.first %} is-active{% endif %}"
                role="listitem"
                data-pdp-thumb
                data-media-id="{{ media.id }}"
                data-index="{{ forloop.index0 }}"
                aria-label="{{ product.title | escape }} — {{ forloop.index }}"
              >
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.alt | default: product.title, widths: '100, 200, 300' }}
              </button>
            {% endfor %}
          </div>
        {% endif %}

        <div class="veylique-pdp-stage">
          {% if product.available == false %}
            <span class="veylique-pdp-badge veylique-pdp-badge--out">{{ 'products.sold_out' | t }}</span>
          {% elsif on_sale %}
            <span class="veylique-pdp-badge">{{ 'products.badge_sale' | t }}</span>
          {% elsif is_new %}
            <span class="veylique-pdp-badge veylique-pdp-badge--new">{{ 'products.badge_new' | t }}</span>
          {% endif %}

          <div class="veylique-pdp-track" data-pdp-track tabindex="0" aria-label="{{ product.title | escape }}">
            {% if has_media %}
              {% for media in product.media %}
                <div
                  class="veylique-pdp-slide"
                  data-pdp-slide
                  data-media-id="{{ media.id }}"
                  data-index="{{ forloop.index0 }}"
                  role="group"
                  aria-roledescription="slide"
                  aria-label="{{ forloop.index }} / {{ product.media.size }}"
                >
                  {% if media.media_type == 'image' %}
                    {% liquid
                      assign slide_loading = 'lazy'
                      if forloop.first
                        assign slide_loading = 'eager'
                      endif
                    %}
                    {{
                      media
                      | image_url: width: 1600
                      | image_tag:
                        loading: slide_loading,
                        sizes: '(min-width: 1000px) 46vw, 100vw',
                        widths: '540, 720, 900, 1200, 1600, 2000',
                        class: 'veylique-pdp-slide-img',
                        alt: media.alt | default: product.title
                    }}
                    <button
                      type="button"
                      class="veylique-pdp-zoom"
                      data-pdp-zoom
                      data-zoom-src="{{ media | image_url: width: 2400 }}"
                      data-index="{{ forloop.index0 }}"
                      aria-label="{{ 'products.zoom_image' | t }}"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                    </button>
                  {% else %}
                    {{ media | media_tag: class: 'veylique-pdp-slide-media' }}
                  {% endif %}
                </div>
              {% endfor %}
            {% else %}
              <div class="veylique-pdp-slide" data-pdp-slide data-index="0">
                {{ 'product-apparel-1' | placeholder_svg_tag: 'veylique-pdp-slide-img' }}
              </div>
            {% endif %}
          </div>

          {% if product.media.size > 1 %}
            <button type="button" class="veylique-pdp-arrow veylique-pdp-arrow--prev" data-pdp-prev aria-label="{{ 'products.previous_image' | t }}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="veylique-pdp-arrow veylique-pdp-arrow--next" data-pdp-next aria-label="{{ 'products.next_image' | t }}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>

            <span class="veylique-pdp-counter" data-pdp-counter aria-hidden="true">1 / {{ product.media.size }}</span>

            <div class="veylique-pdp-dots" aria-hidden="true">
              {% for media in product.media %}
                <span class="veylique-pdp-dot{% if forloop.first %} is-active{% endif %}" data-pdp-dot data-index="{{ forloop.index0 }}"></span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      {% comment %} ---------- Buy box ---------- {% endcomment %}
      <div class="veylique-pdp-info">
        {% if product.vendor != blank %}
          <p class="veylique-pdp-vendor">{{ product.vendor }}</p>
        {% endif %}

        <h1 class="veylique-pdp-title">{{ product.title }}</h1>

        {% if rating_value > 0 %}
          <div class="veylique-pdp-rating">
            <span class="veylique-pdp-rating-stars" aria-hidden="true">
              {% assign rating_rounded = rating_value | round %}
              {% for i in (1..5) %}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="{% if i <= rating_rounded %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% endfor %}
            </span>
            <span class="veylique-pdp-rating-text">{{ rating_value }}{% if rating_count > 0 %} · {{ rating_count }}{% endif %}</span>
          </div>
        {% endif %}

        <div class="veylique-pdp-price" data-pdp-price>
          <span class="veylique-pdp-price-current{% if on_sale %} is-sale{% endif %}" data-pdp-price-current>{{ current_variant.price | money }}</span>
          {% if on_sale %}
            <span class="veylique-pdp-price-compare" data-pdp-price-compare>{{ current_variant.compare_at_price | money }}</span>
            {% assign savings = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round %}
            <span class="veylique-pdp-price-save" data-pdp-price-save>{{ 'products.save_percent_html' | t: percent: savings }}</span>
          {% else %}
            <span class="veylique-pdp-price-compare" data-pdp-price-compare hidden></span>
            <span class="veylique-pdp-price-save" data-pdp-price-save hidden></span>
          {% endif %}
        </div>

        {% form 'product', product, class: 'veylique-pdp-form' %}
          {% unless product.has_only_default_variant %}
            <div class="veylique-pdp-options">
              {% for option in product.options_with_values %}
                {% liquid
                  assign option_name = option.name | downcase
                  assign is_color = false
                  if option_name contains 'color' or option_name contains 'colour'
                    assign is_color = true
                  endif
                  assign is_size = false
                  if option_name contains 'size'
                    assign is_size = true
                  endif
                %}
                <fieldset class="veylique-pdp-option" data-pdp-option data-option-position="{{ option.position }}">
                  <legend class="veylique-pdp-option-head">
                    <span class="veylique-pdp-option-name">{{ option.name }}</span>
                    <span class="veylique-pdp-option-value" data-pdp-option-selected="{{ option.position }}">{{ option.selected_value }}</span>
                    {% if is_size and section.settings.size_guide_text != blank %}
                      <button type="button" class="veylique-pdp-sizeguide-link" data-pdp-sizeguide-open>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.3 8.7l-6-6a1 1 0 0 0-1.4 0l-11.2 11.2a1 1 0 0 0 0 1.4l6 6a1 1 0 0 0 1.4 0l11.2-11.2a1 1 0 0 0 0-1.4z"/><path d="M7.5 10.5l1.5 1.5"/><path d="M10.5 7.5l1.5 1.5"/><path d="M13.5 4.5l1.5 1.5"/></svg>
                        {{ 'products.size_guide' | t }}
                      </button>
                    {% endif %}
                  </legend>
                  <div class="veylique-pdp-swatches{% if is_color %} is-color{% endif %}">
                    {% for value in option.values %}
                      {% liquid
                        assign input_id = section.id | append: '-opt' | append: option.position | append: '-' | append: forloop.index
                        assign is_checked = false
                        if option.selected_value == value
                          assign is_checked = true
                        endif
                      %}
                      <input
                        type="radio"
                        class="veylique-pdp-swatch-input"
                        name="option{{ option.position }}"
                        id="{{ input_id }}"
                        value="{{ value | escape }}"
                        data-pdp-swatch
                        data-option-position="{{ option.position }}"
                        {% if is_checked %}checked{% endif %}
                      >
                      {% if is_color %}
                        <label class="veylique-pdp-swatch veylique-pdp-swatch--color" for="{{ input_id }}" title="{{ value | escape }}">
                          <span
                            class="veylique-pdp-swatch-chip"
                            style="{% if value.swatch.image %}background-image: url({{ value.swatch.image | image_url: width: 80 }});{% elsif value.swatch.color %}background: {{ value.swatch.color }};{% else %}background: {{ value | handleize }};{% endif %}"
                          ></span>
                          <span class="visually-hidden">{{ value }}</span>
                        </label>
                      {% else %}
                        <label class="veylique-pdp-swatch" for="{{ input_id }}">{{ value }}</label>
                      {% endif %}
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            </div>
          {% endunless %}

          {% if section.settings.low_stock_threshold > 0 %}
            <p class="veylique-pdp-stock" data-pdp-stock hidden>
              <span class="veylique-pdp-stock-dot" aria-hidden="true"></span>
              <span data-pdp-stock-text></span>
            </p>
          {% endif %}

          <div class="veylique-pdp-actions">
            <div class="veylique-pdp-qty" data-pdp-qty>
              <button type="button" class="veylique-pdp-qty-btn" data-pdp-qty-down aria-label="{{ 'products.decrease_quantity' | t }}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <input type="number" class="veylique-pdp-qty-input" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.quantity' | t }}" data-pdp-qty-input>
              <button type="button" class="veylique-pdp-qty-btn" data-pdp-qty-up aria-label="{{ 'products.increase_quantity' | t }}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            </div>

            <input type="hidden" name="id" value="{{ current_variant.id }}" data-pdp-variant-id>

            <button
              type="submit"
              name="add"
              class="veylique-pdp-atc veylique-btn btn-black"
              data-pdp-atc
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-pdp-atc-text>
                {% if current_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}
              </span>
            </button>
          </div>

          {{ form | payment_button }}
        {% endform %}

        {% assign has_trust = false %}
        {% for block in section.blocks %}
          {% if block.type == 'trust' and block.settings.text != blank %}
            {% assign has_trust = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% if has_trust %}
          <ul class="veylique-pdp-trust">
            {% for block in section.blocks %}
              {% if block.type == 'trust' and block.settings.text != blank %}
                <li class="veylique-pdp-trust-item" {{ block.shopify_attributes }}>
                  {% case block.settings.icon %}
                    {% when 'returns' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                    {% when 'secure' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                    {% when 'quality' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5L17 22l-5-3-5 3 1.5-8.5"/></svg>
                    {% else %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {% endcase %}
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        <div class="veylique-pdp-meta">
          <button type="button" class="veylique-pdp-wish" data-veylique-wish aria-label="{{ 'products.add_to_wishlist' | t: title: product.title }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span>{{ 'products.add_to_wishlist' | t: title: '' | strip }}</span>
          </button>
          <button type="button" class="veylique-pdp-share" data-pdp-share data-share-title="{{ product.title | escape }}" data-share-url="{{ request.origin }}{{ product.url }}">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <span>{{ 'products.share' | t }}</span>
          </button>
          {% if current_variant.sku != blank %}
            <span class="veylique-pdp-sku" data-pdp-sku>{{ 'products.sku' | t }}: {{ current_variant.sku }}</span>
          {% else %}
            <span class="veylique-pdp-sku" data-pdp-sku hidden></span>
          {% endif %}
        </div>

        <div class="veylique-pdp-accordions">
          {% if product.description != blank %}
            <details class="veylique-pdp-acc" open>
              <summary class="veylique-pdp-acc-head">{{ 'products.description' | t }}<span class="veylique-pdp-acc-icon" aria-hidden="true"></span></summary>
              <div class="veylique-pdp-acc-body rte">{{ product.description }}</div>
            </details>
          {% endif %}

          {% if section.settings.details_text != blank %}
            <details class="veylique-pdp-acc">
              <summary class="veylique-pdp-acc-head">{{ 'products.details' | t }}<span class="veylique-pdp-acc-icon" aria-hidden="true"></span></summary>
              <div class="veylique-pdp-acc-body rte">{{ section.settings.details_text }}</div>
            </details>
          {% endif %}

          {% if section.settings.shipping_text != blank %}
            <details class="veylique-pdp-acc">
              <summary class="veylique-pdp-acc-head">{{ 'products.shipping_returns' | t }}<span class="veylique-pdp-acc-icon" aria-hidden="true"></span></summary>
              <div class="veylique-pdp-acc-body rte">{{ section.settings.shipping_text }}</div>
            </details>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% comment %} ---------- Sticky mobile add-to-cart bar ---------- {% endcomment %}
  <div class="veylique-pdp-stickybar" data-pdp-sticky aria-hidden="true">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'veylique-pdp-stickybar-thumb', alt: product.title, widths: '60, 120' }}
    {% endif %}
    <div class="veylique-pdp-stickybar-meta">
      <p class="veylique-pdp-stickybar-title">{{ product.title | escape }}</p>
      <p class="veylique-pdp-stickybar-price" data-pdp-sticky-price>{{ current_variant.price | money }}</p>
    </div>
    <button type="button" class="veylique-pdp-stickybar-atc veylique-btn btn-black" data-pdp-sticky-atc>
      <span data-pdp-sticky-atc-text>{% if current_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
    </button>
  </div>

  {% comment %} ---------- Lightbox ---------- {% endcomment %}
  <dialog class="veylique-pdp-lightbox" data-pdp-lightbox aria-label="{{ product.title | escape }}">
    <button type="button" class="veylique-pdp-lightbox-close" data-pdp-lightbox-close aria-label="{{ 'products.close_gallery' | t }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button type="button" class="veylique-pdp-lightbox-nav veylique-pdp-lightbox-nav--prev" data-pdp-lightbox-prev aria-label="{{ 'products.previous_image' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <img class="veylique-pdp-lightbox-img" data-pdp-lightbox-img width="2400" height="3200" alt="{{ product.title | escape }}">
    <button type="button" class="veylique-pdp-lightbox-nav veylique-pdp-lightbox-nav--next" data-pdp-lightbox-next aria-label="{{ 'products.next_image' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </dialog>

  {% comment %} ---------- Size guide ---------- {% endcomment %}
  {% if section.settings.size_guide_text != blank %}
    <dialog class="veylique-pdp-sizeguide" data-pdp-sizeguide aria-label="{{ 'products.size_guide' | t }}">
      <div class="veylique-pdp-sizeguide-head">
        <h2 class="veylique-pdp-sizeguide-title">{{ 'products.size_guide' | t }}</h2>
        <button type="button" class="veylique-pdp-lightbox-close veylique-pdp-sizeguide-close" data-pdp-sizeguide-close aria-label="{{ 'products.close_gallery' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="veylique-pdp-sizeguide-body rte">{{ section.settings.size_guide_text }}</div>
    </dialog>
  {% endif %}

  <script type="application/json" data-pdp-variants>
    [
      {%- for v in product.variants -%}
        {
          "id": {{ v.id }},
          "available": {{ v.available }},
          "options": {{ v.options | json }},
          "price": {{ v.price | money | json }},
          "compare_at_price": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
          "price_num": {{ v.price }},
          "compare_num": {{ v.compare_at_price | default: 0 }},
          "featured_media_id": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %},
          "sku": {{ v.sku | json }},
          "inventory_managed": {% if v.inventory_management == 'shopify' %}true{% else %}false{% endif %},
          "inventory_policy": {{ v.inventory_policy | json }},
          "inventory_quantity": {{ v.inventory_quantity | default: 0 }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>

  <script type="application/json" data-pdp-config>
    {
      "cartUrl": {{ routes.cart_url | json }},
      "lowStockThreshold": {{ section.settings.low_stock_threshold | default: 0 }},
      "strings": {
        "soldOut": {{ 'products.sold_out' | t | json }},
        "unavailable": {{ 'products.unavailable' | t | json }},
        "adding": {{ 'products.adding' | t | json }},
        "added": {{ 'products.added' | t | json }},
        "viewCart": {{ 'products.view_cart' | t | json }},
        "error": {{ 'products.quantity_error' | t | json }},
        "inStock": {{ 'products.in_stock' | t | json }},
        "onlyLeft": {{ 'products.only_left' | t: count: '[COUNT]' | json }},
        "shareCopied": {{ 'products.share_copied' | t | json }}
      }
    }
  </script>

  <div class="veylique-pdp-toast" data-pdp-toast role="status" aria-live="polite"></div>
</section>

{% stylesheet %}
  .veylique-pdp {
    background: var(--veylique-color-surface, #fff);
    color: var(--veylique-color-foreground, #241f1a);
    padding: clamp(1.25rem, 4vw, 2.5rem) 0 clamp(3.5rem, 8vw, 6rem);
  }

  .veylique-pdp-inner {
