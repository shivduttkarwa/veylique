  .veylique-pdp-slide:hover .veylique-pdp-zoom,
  .veylique-pdp-zoom:focus-visible { opacity: 1; }
  @media (hover: none), (pointer: coarse) {
    .veylique-pdp-zoom { opacity: 1; }
