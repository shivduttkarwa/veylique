{% doc %}
  Renders a Veylique product card — editorial minimal: square edges, full-bleed
  image, micro-caps labels and hairline rules.

  Keeps the two-image hover swap (desktop only) — for real products the hover
  frame is the third product image (the alternate model angle), falling back to
  the second when a product has fewer images. Carries a wishlist mark,
  sale/sold-out badges, a hover "shop" or quick-add tray, and price with
  compare-at + discount. On touch devices it shows a single static image and no
  hover chrome. Prefers real Shopify product data; falls back to merchant
  text/image, then a placeholder.

  @param {product} [product] - Shopify product. When set, its data wins.
  @param {boolean} [placeholder] - Render an onboarding placeholder card.
  @param {string} [title] - Fallback product title.
  @param {string} [price] - Fallback price text.
  @param {image} [image] - Merchant-selected main image.
  @param {image} [hover_image] - Merchant-selected hover image.
  @param {string} [fallback] - Theme asset fallback for the main image.
  @param {string} [hover_fallback] - Theme asset fallback for the hover image.
  @param {string} [link] - Fallback destination.
  @param {boolean} [show_brand] - Show vendor/brand line, inline discount and rating badge (shop/PLP layout).
  @param {boolean} [quick_add] - Show a hover "add to bag" action with size chips (real products only).

  @example
  {% render 'veylique-home-product-card', product: product %}
  {% render 'veylique-home-product-card', product: product, show_brand: true, quick_add: true %}
{% enddoc %}

{% liquid
  assign card_title = title | default: 'Veylique piece'
  assign card_price = price
  if card_price == blank
    assign card_price = 1990 | money
  endif
  assign card_compare = blank
  assign card_link = link | default: routes.all_products_collection_url
  assign card_image = image
  assign card_hover_image = hover_image
  assign on_sale = false
  assign sold_out = false
  assign discount = 0
  assign card_vendor = ''
  assign rating_value = 0
  assign rating_count = 0
  assign show_size_chips = false

  if product != blank
    assign card_title = product.title
    assign card_link = product.url
    assign card_price = product.price | money
    assign card_image = product.featured_image
    assign card_hover_image = product.images[2]
    if card_hover_image == blank
      assign card_hover_image = product.images[1]
    endif
    assign card_vendor = product.vendor
    unless product.available
      assign sold_out = true
    endunless
    if product.compare_at_price > product.price
      assign on_sale = true
      assign card_compare = product.compare_at_price | money
      assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
    endif

    if product.metafields.reviews.rating != blank
      assign rating_value = product.metafields.reviews.rating.value | round: 1
      assign rating_count = product.metafields.reviews.rating_count | default: 0
    endif

    if product.options.size == 1
      assign first_option = product.options.first | downcase
      if first_option contains 'size'
        assign show_size_chips = true
      endif
    endif
  endif

  assign is_new = false
  if product != blank and sold_out == false
    assign new_cutoff = 'now' | date: '%s' | minus: 2592000
    assign published = product.published_at | date: '%s' | plus: 0
    if published > new_cutoff
      assign is_new = true
    endif
  endif

  assign color_option = blank
  if product != blank
    for card_option in product.options_with_values
      assign card_option_name = card_option.name | downcase
      if card_option_name contains 'color' or card_option_name contains 'colour'
        assign color_option = card_option
        break
      endif
    endfor
  endif

  assign main_fallback = fallback | default: 'hero-1.webp'
  assign secondary_fallback = hover_fallback | default: main_fallback
%}

<article class="veylique-pcard veylique-reveal-js veylique-reveal--static-js">
  <div class="veylique-pcard__media-wrap">
    <a class="veylique-pcard__media-link" href="{{ card_link }}" aria-label="{{ card_title | escape }}">
      {% if sold_out %}
        <span class="veylique-pcard__badge veylique-pcard__badge--out">{{ 'products.sold_out' | t }}</span>
      {% elsif on_sale %}
        <span class="veylique-pcard__badge veylique-pcard__badge--sale">{% if discount > 0 %}{{ 'products.save_percent_html' | t: percent: discount }}{% else %}{{ 'products.badge_sale' | t }}{% endif %}</span>
      {% elsif is_new %}
        <span class="veylique-pcard__badge veylique-pcard__badge--new">{{ 'products.badge_new' | t }}</span>
      {% endif %}

      <div class="veylique-pcard__media">
        {% render 'veylique-responsive-image',
          image: card_image,
          fallback: main_fallback,
          placeholder: placeholder,
          placeholder_name: 'product-apparel-1',
          class: 'veylique-pcard__img veylique-pcard__img--main',
          alt: card_title,
          width: 900,
          height: 1200
        %}
        {% render 'veylique-responsive-image',
          image: card_hover_image,
          fallback: secondary_fallback,
          placeholder: placeholder,
          placeholder_name: 'product-apparel-2',
          class: 'veylique-pcard__img veylique-pcard__img--hover',
          alt: '',
          width: 900,
          height: 1200
        %}
      </div>
    </a>

    <button
      class="veylique-pcard__wish"
      type="button"
      data-veylique-wish
      {% if product != blank %}
        data-product-handle="{{ product.handle }}"
      {% endif %}
      aria-pressed="false"
      data-label-add="{{ 'products.add_to_wishlist' | t: title: card_title | escape }}"
      data-label-remove="{{ 'products.remove_from_wishlist' | t: title: card_title | escape }}"
      aria-label="{{ 'products.add_to_wishlist' | t: title: card_title }}"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>

    {% unless sold_out %}
      {% if quick_add and product != blank %}
        <div class="veylique-pcard__qa">
          {% if show_size_chips %}
            <span class="veylique-pcard__qa-label">{{ 'products.select_size' | t }}</span>
            <div class="veylique-pcard__sizes">
              {% for variant in product.variants %}
                <a
                  class="veylique-pcard__size{% unless variant.available %} is-oos{% endunless %}"
                  href="{{ product.url }}?variant={{ variant.id }}"
                  {% if variant.available %}
                    data-veylique-quick-add
                    data-variant-id="{{ variant.id }}"
                    data-added-label="{{ 'products.added' | t | escape }}"
                    aria-label="{{ 'products.add_to_cart' | t }} — {{ card_title | escape }} {{ variant.title | escape }}"
                  {% endif %}
                >{{ variant.title | escape }}</a>
              {% endfor %}
            </div>
          {% elsif product != blank and product.variants.size == 1 %}
            <a
              class="veylique-pcard__add"
              href="{{ card_link }}"
              data-veylique-quick-add
              data-variant-id="{{ product.first_available_variant.id }}"
              data-added-label="{{ 'products.added' | t | escape }}"
            >{{ 'products.add_to_cart' | t }}</a>
          {% else %}
            <a class="veylique-pcard__add" href="{{ card_link }}">{{ 'products.choose_options' | t }}</a>
          {% endif %}
        </div>
      {% else %}
        <a class="veylique-pcard__shop" href="{{ card_link }}" tabindex="-1" aria-hidden="true">{{ 'products.choose_options' | t }}</a>
      {% endif %}
    {% endunless %}
  </div>

  <div class="veylique-pcard__info">
    {% if show_brand and card_vendor != blank %}
      <p class="veylique-pcard__brand">{{ card_vendor | escape }}</p>
    {% endif %}

    <h3 class="veylique-pcard__title"><a href="{{ card_link }}">{{ card_title }}</a></h3>

    <div class="veylique-pcard__price">
      <span class="veylique-pcard__price-now{% if on_sale %} is-sale{% endif %}">{{ card_price }}</span>
      {% if card_compare != blank %}
        <span class="veylique-pcard__price-old">{{ card_compare }}</span>
      {% endif %}
      {% if discount > 0 %}
        <span class="veylique-pcard__discount">{{ 'products.save_percent_html' | t: percent: discount }}</span>
      {% endif %}
    </div>

    {% if show_brand and rating_value > 0 %}
      <p class="veylique-pcard__rating">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span class="veylique-pcard__rating-value">{{ rating_value }}</span>
        {% if rating_count > 0 %}<span class="veylique-pcard__rating-count">({{ rating_count }})</span>{% endif %}
      </p>
    {% endif %}
  </div>

  {% if color_option != blank and color_option.values.size > 1 %}
    <a class="veylique-pcard__colors" href="{{ card_link }}" aria-label="{{ color_option.name | escape }}: {{ color_option.values | join: ', ' | escape }}">
      {% for value in color_option.values limit: 4 %}
        <span
          class="veylique-pcard__dot"
          style="{% if value.swatch.image %}background-image: url({{ value.swatch.image | image_url: width: 40 }});{% elsif value.swatch.color %}background: {{ value.swatch.color }};{% else %}background: {{ value | handleize }};{% endif %}"
        ></span>
      {% endfor %}
      {% if color_option.values.size > 4 %}
        <span class="veylique-pcard__dot-more">+{{ color_option.values.size | minus: 4 }}</span>
      {% endif %}
    </a>
  {% endif %}
</article>

{% stylesheet %}
  /* ==========================================================================
     Veylique product card — editorial minimal.

     Square edges, full-bleed image, micro-caps labels and hairline rules. The
     image carries the card; chrome stays out of the way until it's wanted.
     Controls are hidden until hover on fine pointers and always present on
     touch, where there is no hover to reveal them.
     ========================================================================== */

  .veylique-pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: transparent;
  }

  /* ---- Media ------------------------------------------------------------- */

  .veylique-pcard__media-wrap {
    position: relative;
    overflow: hidden;
    background: var(--veylique-color-surface-alt, #faf6ec);
    aspect-ratio: 3 / 4;
  }

  .veylique-pcard__media-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .veylique-pcard__media {
    position: relative;
    width: 100%;
    height: 100%;
    isolation: isolate;
  }

  .veylique-pcard__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    backface-visibility: hidden;
  }

  .veylique-pcard__img--main {
    z-index: 1;
    transition: transform 1.6s var(--veylique-ease-standard, cubic-bezier(0.22, 1, 0.36, 1));
  }

  /* A quiet cross-dissolve rather than a wipe: the second angle should arrive
     without announcing itself. Gated on .is-loaded (set by the theme's card JS)
     so a half-fetched image never fades in. */
  .veylique-pcard__img--hover {
    z-index: 2;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 0.7s var(--veylique-ease-standard, cubic-bezier(0.22, 1, 0.36, 1)),
      transform 1.6s var(--veylique-ease-standard, cubic-bezier(0.22, 1, 0.36, 1));
  }

  @media (hover: hover) and (pointer: fine) {
    .veylique-pcard__media-wrap:hover .veylique-pcard__img--main {
      transform: scale(1.04);
    }
    .veylique-pcard__media-wrap:hover .veylique-pcard__img--hover.is-loaded {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Touch / coarse pointer: single static image, nothing changes on tap. */
  @media (hover: none), (pointer: coarse) {
    .veylique-pcard__img--hover { display: none; }
  }

  /* ---- Badge ------------------------------------------------------------- */

  /* Flush to the corner and unrounded — a printed tag, not a sticker. */
  .veylique-pcard__badge {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 4;
    padding: 0.4375rem 0.6875rem;
    background: var(--veylique-color-surface, #fff);
    color: var(--veylique-color-foreground, #241f1a);
    font-family: var(--veylique-font-body);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
  }
  .veylique-pcard__badge--sale {
    color: var(--veylique-color-rose, #c58d80);
  }
  .veylique-pcard__badge--new {
    color: var(--veylique-color-secondary, #6f7d68);
  }
  .veylique-pcard__badge--out {
    background: var(--veylique-color-foreground, #241f1a);
    color: var(--veylique-color-surface, #fff);
  }

  /* ---- Wishlist ---------------------------------------------------------- */

  /* No chip or circle — just the mark, with a white halo so it stays legible
     over a dark photograph. */
  .veylique-pcard__wish {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--veylique-color-foreground, #241f1a);
    cursor: pointer;
    filter: drop-shadow(0 0 0.1875rem rgba(255, 255, 255, 0.95));
    transition:
      opacity 0.3s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  /* On a fine pointer the mark waits for hover — but a saved item always shows
     its state, otherwise the card would silently forget it. */
  @media (hover: hover) and (pointer: fine) {
    .veylique-pcard__wish { opacity: 0; }
    .veylique-pcard__media-wrap:hover .veylique-pcard__wish,
    .veylique-pcard__wish:focus-visible,
    .veylique-pcard__wish.is-wished { opacity: 1; }
    .veylique-pcard__wish:hover { transform: scale(1.1); }
  }

  .veylique-pcard__wish.is-wished { color: var(--veylique-color-rose, #c58d80); }
  .veylique-pcard__wish.is-wished svg { fill: currentColor; }

  /* The theme's wishlist JS has always toggled .is-pulsing on tap; nothing ever
     drew it, so the save landed with no feedback. */
  .veylique-pcard__wish.is-pulsing svg {
    animation: veylique-pcard-pulse 0.42s var(--veylique-ease-standard, ease);
  }
  @keyframes veylique-pcard-pulse {
    0%   { transform: scale(1); }
    45%  { transform: scale(1.28); }
    100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .veylique-pcard__wish.is-pulsing svg { animation: none; }
  }

  /* ---- Hover actions ----------------------------------------------------- */

  /* Both the plain "shop" link and the quick-add tray ride the bottom edge as a
     full-bleed bar with a hairline above it. */
  .veylique-pcard__shop,
  .veylique-pcard__qa {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    border-top: var(--veylique-border-width, 0.0625rem) solid var(--veylique-color-border, rgba(36, 31, 26, 0.14));
    background: var(--veylique-color-surface, #fff);
    transform: translateY(100%);
    transition: transform 0.45s var(--veylique-ease-standard, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .veylique-pcard__shop {
    display: none;
    align-items: center;
    justify-content: center;
    height: 2.875rem;
    color: var(--veylique-color-foreground, #241f1a);
    font-family: var(--veylique-font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .veylique-pcard__qa {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    padding: 0.75rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .veylique-pcard__shop { display: inline-flex; }
    .veylique-pcard__media-wrap:hover .veylique-pcard__shop,
    .veylique-pcard__media-wrap:hover .veylique-pcard__qa,
    .veylique-pcard__media-wrap:focus-within .veylique-pcard__qa {
      transform: translateY(0);
    }
  }

  /* Touch: hide the hover tray — tapping the card opens the product. */
  @media (hover: none), (pointer: coarse) {
    .veylique-pcard__qa { display: none; }
  }

  .veylique-pcard__qa-label {
    font-family: var(--veylique-font-body);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--veylique-color-muted, #756b60);
    text-align: center;
  }

  .veylique-pcard__sizes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
  }

  .veylique-pcard__size {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.125rem;
    height: 2.125rem;
    padding: 0 0.5rem;
    border: var(--veylique-border-width, 0.0625rem) solid var(--veylique-color-border, rgba(36, 31, 26, 0.14));
    background: var(--veylique-color-surface, #fff);
    color: var(--veylique-color-foreground, #241f1a);
    font-family: var(--veylique-font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }
  @media (hover: hover) {
    .veylique-pcard__size:hover {
      border-color: var(--veylique-color-foreground, #241f1a);
      background: var(--veylique-color-foreground, #241f1a);
      color: var(--veylique-color-surface, #fff);
    }
  }
  .veylique-pcard__size.is-oos {
    color: var(--veylique-color-muted, #756b60);
    text-decoration: line-through;
    opacity: 0.6;
  }

  .veylique-pcard__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.625rem;
    background: var(--veylique-color-foreground, #241f1a);
    color: var(--veylique-color-surface, #fff);
    font-family: var(--veylique-font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* ---- Information ------------------------------------------------------- */

  .veylique-pcard__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3125rem;
    padding-top: 1rem;
  }

  .veylique-pcard__brand {
    margin: 0;
    max-width: 100%;
    font-family: var(--veylique-font-body);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--veylique-color-muted, #756b60);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .veylique-pcard__title {
    margin: 0;
    max-width: 100%;
    min-width: 0;
    font-family: var(--veylique-font-heading, serif);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* The rule is drawn in transparent and simply gains colour, so it tracks the
     text rather than the full column width an ellipsised block would give. */
  .veylique-pcard__title a {
    display: block;
    color: var(--veylique-color-foreground, #241f1a);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.35s ease;
  }
  @media (hover: hover) {
    .veylique-pcard:hover .veylique-pcard__title a {
      text-decoration-color: currentColor;
    }
  }

  .veylique-pcard__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--veylique-font-body);
    font-variant-numeric: tabular-nums;
  }
  .veylique-pcard__price-now {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--veylique-color-foreground, #241f1a);
  }
  .veylique-pcard__price-now.is-sale {
    color: var(--veylique-color-rose, #c58d80);
  }
  .veylique-pcard__price-old {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--veylique-color-muted, #756b60);
    text-decoration: line-through;
  }
  .veylique-pcard__discount {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--veylique-color-rose, #c58d80);
  }

  /* Rating sits with the copy instead of floating on the photograph. */
  .veylique-pcard__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0.0625rem 0 0;
    font-family: var(--veylique-font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    color: var(--veylique-color-foreground, #241f1a);
  }
  .veylique-pcard__rating svg { color: var(--veylique-color-secondary, #6f7d68); }
  .veylique-pcard__rating-count {
    font-weight: 400;
    color: var(--veylique-color-muted, #756b60);
  }

  /* ---- Colour swatches --------------------------------------------------- */

  .veylique-pcard__colors {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    margin-top: 0.625rem;
    text-decoration: none;
  }
  .veylique-pcard__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 0.0625rem solid rgba(36, 31, 26, 0.2);
    background-size: cover;
    background-position: center;
    transition: transform 0.2s var(--veylique-ease-standard, ease);
  }
  @media (hover: hover) {
    .veylique-pcard__colors:hover .veylique-pcard__dot { transform: scale(1.18); }
  }
  .veylique-pcard__dot-more {
    font-family: var(--veylique-font-body);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--veylique-color-muted, #756b60);
  }

  /* ---- Quick add busy / added states ------------------------------------- */

  .veylique-pcard__size.is-busy,
  .veylique-pcard__add.is-busy {
    opacity: 0.55;
    pointer-events: none;
  }
  .veylique-pcard__size.is-added {
    border-color: var(--veylique-color-secondary, #6f7d68);
    background: var(--veylique-color-secondary, #6f7d68);
    color: #fff;
  }
  .veylique-pcard__add.is-added {
    background: var(--veylique-color-secondary, #6f7d68);
  }

  /* ---- Focus ------------------------------------------------------------- */

  .veylique-pcard__media-link:focus-visible,
  .veylique-pcard__wish:focus-visible,
  .veylique-pcard__shop:focus-visible,
  .veylique-pcard__size:focus-visible,
  .veylique-pcard__add:focus-visible,
  .veylique-pcard__colors:focus-visible,
  .veylique-pcard__title a:focus-visible {
    outline: var(--veylique-focus-ring-width, 0.125rem) solid var(--veylique-focus-ring-color, #241f1a);
    outline-offset: var(--veylique-focus-ring-offset, 0.1875rem);
  }

  /* ---- Reduced motion ---------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    .veylique-pcard__img--main,
    .veylique-pcard__img--hover,
    .veylique-pcard__shop,
    .veylique-pcard__qa,
    .veylique-pcard__wish,
    .veylique-pcard__size,
    .veylique-pcard__dot,
    .veylique-pcard__title a {
      transition: none;
    }
    .veylique-pcard__img--hover { transform: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (window.veyliqueQuickAddReady) return;
    window.veyliqueQuickAddReady = true;

    function updateCartCount(count) {
      var el = document.querySelector('.veylique-cart-count');
      if (el) { el.textContent = count; return; }
      var trigger = document.querySelector('.veylique-cart-trigger');
      if (trigger && count > 0) {
        var span = document.createElement('span');
        span.className = 'veylique-cart-count';
        span.textContent = count;
        trigger.appendChild(span);
      }
    }

    document.addEventListener('click', function (event) {
      var link = event.target.closest('[data-veylique-quick-add]');
      if (!link || !window.fetch) return; /* no JS support: follow the href */
      event.preventDefault();
      if (link.classList.contains('is-busy') || link.classList.contains('is-added')) return;

      link.classList.add('is-busy');
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: parseInt(link.dataset.variantId, 10), quantity: 1 })
      })
        .then(function (r) { if (!r.ok) throw new Error('add'); return r.json(); })
        .then(function () { return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }); })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          updateCartCount(cart.item_count);
          /* Refresh the drawer, but leave it closed: interrupting a browsing
             shopper with a panel is worse than the quiet "Added" state and the
             header count they already get. */
          document.dispatchEvent(new CustomEvent('veylique:cart:updated', { detail: { open: false } }));
          link.classList.add('is-added');
          var isTextButton = link.classList.contains('veylique-pcard__add');
          if (isTextButton && link.dataset.addedLabel) {
            if (!link.dataset.originalLabel) link.dataset.originalLabel = link.textContent;
            link.textContent = link.dataset.addedLabel;
          }
          window.setTimeout(function () {
            link.classList.remove('is-added');
            if (isTextButton && link.dataset.originalLabel) {
              link.textContent = link.dataset.originalLabel;
            }
          }, 2000);
        })
        .catch(function () { window.location.href = link.href; })
        .finally(function () { link.classList.remove('is-busy'); });
    });
  })();
{% endjavascript %}
