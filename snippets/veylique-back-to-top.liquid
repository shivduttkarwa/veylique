{% doc %}
  Renders the floating "back to top" button.

  Rendered once from layout/theme.liquid so it is available on every template.
  It stays hidden until the shopper has scrolled roughly one viewport, then
  fades in at the bottom-right.

  @example
  {% render 'veylique-back-to-top' %}
{% enddoc %}

<button
  type="button"
  class="veylique-to-top"
  data-veylique-to-top
  aria-label="{{ 'general.back_to_top' | t }}"
  title="{{ 'general.back_to_top' | t }}"
  hidden
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="12" y1="19" x2="12" y2="5"/>
    <polyline points="5 12 12 5 19 12"/>
  </svg>
</button>

{% stylesheet %}
  .veylique-to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: calc(clamp(1rem, 3vw, 2rem) + env(safe-area-inset-bottom, 0px));
    /* Above page content, but deliberately below the cart drawer (961) and its
       scrim (960) so it cannot float over an open drawer, and below the header
       (900) so it never fights the navigation. */
    z-index: 80;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px hit area. */
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: var(--veylique-border-width) solid var(--veylique-color-border);
    border-radius: 50%;
    background: var(--veylique-color-surface, #ffffff);
    color: var(--veylique-color-foreground);
    cursor: pointer;
    box-shadow: 0 0.5rem 1.5rem rgba(36, 31, 26, 0.12);
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity var(--veylique-duration-base) ease,
      transform var(--veylique-duration-base) var(--veylique-ease-standard),
      background-color var(--veylique-duration-fast) ease,
      color var(--veylique-duration-fast) ease;
  }

  .veylique-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .veylique-to-top svg { display: block; }

  @media (hover: hover) {
    .veylique-to-top:hover {
      background: var(--veylique-color-foreground);
      color: var(--veylique-color-background);
      border-color: var(--veylique-color-foreground);
    }
  }

  .veylique-to-top:focus-visible {
    outline: var(--veylique-focus-ring-width) solid var(--veylique-focus-ring-color);
    outline-offset: var(--veylique-focus-ring-offset);
  }

  /* The product page's sticky add-to-bag bar owns the bottom of the screen on
     mobile, so step above it rather than overlapping. */
  @media (max-width: 989.98px) {
    body.template-product .veylique-to-top {
      bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .veylique-to-top { transition: opacity var(--veylique-duration-fast) ease; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var button = document.querySelector('[data-veylique-to-top]');
    if (!button) return;

    /* Show once the shopper is a screen deep — early enough to be useful,
       late enough not to hover over the hero. */
    function threshold() {
      return Math.max(window.innerHeight * 0.9, 600);
    }

    var scheduled = false;

    function update() {
      scheduled = false;
      var show = window.pageYOffset > threshold();
      /* `hidden` keeps it out of the tab order while it is invisible. */
      if (show && button.hidden) button.hidden = false;
      button.classList.toggle('is-visible', show);
      if (!show && !button.hidden) {
        window.setTimeout(function () {
          if (!button.classList.contains('is-visible')) button.hidden = true;
        }, 250);
      }
    }

    function onScroll() {
      if (scheduled) return;
      scheduled = true;
      window.requestAnimationFrame(update);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    button.addEventListener('click', function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });

      /* Return focus to the top of the document, so a keyboard user carries on
         from the start of the page rather than from a button that just left. */
      var main = document.getElementById('MainContent');
      if (main) main.focus({ preventScroll: true });
    });

    update();
  })();
{% endjavascript %}
