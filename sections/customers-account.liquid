{% comment %}
  Customer account — order history and the default address.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/customers-account
{% endcomment %}

{% liquid
  # Resolve the greeting name before translating: a filter written after `| t`
  # would apply to the translated string, not to the interpolated argument.
  assign account_name = customer.first_name
  if account_name == blank
    assign account_name = customer.name
  endif
%}

<section class="veylique-account veylique-page full-width" aria-labelledby="VeyliqueAccountTitle-{{ section.id }}">
  <div class="veylique-container">
    <header class="veylique-account__head">
      <div>
        <p class="veylique-kicker">{{ 'customers.account.eyebrow' | t }}</p>
        <h1 id="VeyliqueAccountTitle-{{ section.id }}" class="veylique-account__title">
          {{ 'customers.account.title' | t: name: account_name }}
        </h1>
      </div>
      <a href="{{ routes.account_logout_url }}" class="veylique-button veylique-button--outline">
        {{ 'customers.account.logout' | t }}
      </a>
    </header>

    <div class="veylique-account__grid">
      <div class="veylique-account__orders">
        <h2 class="veylique-account__subtitle">{{ 'customers.orders.title' | t }}</h2>

        {%- paginate customer.orders by 12 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="veylique-account__table-wrap">
              <table class="veylique-account__table">
                <caption class="visually-hidden">{{ 'customers.orders.title' | t }}</caption>
                <thead>
                  <tr>
                    <th scope="col">{{ 'customers.orders.order_number' | t }}</th>
                    <th scope="col">{{ 'customers.orders.date' | t }}</th>
                    <th scope="col">{{ 'customers.orders.payment_status' | t }}</th>
                    <th scope="col">{{ 'customers.orders.fulfillment_status' | t }}</th>
                    <th scope="col">{{ 'customers.orders.total' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <td data-label="{{ 'customers.orders.order_number' | t }}">
                        <a href="{{ order.customer_url }}">{{ order.name }}</a>
                      </td>
                      <td data-label="{{ 'customers.orders.date' | t }}">{{ order.created_at | date: format: 'date' }}</td>
                      <td data-label="{{ 'customers.orders.payment_status' | t }}">{{ order.financial_status_label }}</td>
                      <td data-label="{{ 'customers.orders.fulfillment_status' | t }}">{{ order.fulfillment_status_label }}</td>
                      <td data-label="{{ 'customers.orders.total' | t }}">{{ order.total_price | money_with_currency }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>

            {%- if paginate.pages > 1 -%}
              <nav class="veylique-pagination" aria-label="{{ 'customers.orders.pagination' | t }}">
                {{ paginate | default_pagination }}
              </nav>
            {%- endif -%}
          {%- else -%}
            <p class="veylique-text">{{ 'customers.orders.none' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="veylique-button veylique-button--solid">
              {{ 'customers.orders.start_shopping' | t }}
            </a>
          {%- endif -%}
        {%- endpaginate -%}
      </div>

      <aside class="veylique-account__aside">
        <h2 class="veylique-account__subtitle">{{ 'customers.account.default_address' | t }}</h2>

        {%- if customer.default_address -%}
          <address class="veylique-account__address">
            {{ customer.default_address | format_address }}
          </address>
        {%- else -%}
          <p class="veylique-text">{{ 'customers.account.no_address' | t }}</p>
        {%- endif -%}

        <a href="{{ routes.account_addresses_url }}" class="veylique-button veylique-button--outline">
          {{ 'customers.account.view_addresses' | t: count: customer.addresses_count }}
        </a>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.customers-account.name",
  "settings": []
}
{% endschema %}
