  .veylique-pdp-lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--veylique-color-foreground, #241f1a);
    cursor: pointer;
  }
  .veylique-pdp-lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--veylique-color-foreground, #241f1a);
    cursor: pointer;
  }
  .veylique-pdp-lightbox-nav--prev { left: 1.25rem; }
  .veylique-pdp-lightbox-nav--next { right: 1.25rem; }

  .veylique-pdp-sizeguide {
    margin: auto;
    width: min(92vw, 34rem);
    max-height: 84vh;
    overflow: auto;
    border-radius: var(--veylique-radius-lg, 1rem);
    background: var(--veylique-color-surface, #fff);
  }
  .veylique-pdp-sizeguide-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem 1rem;
    background: var(--veylique-color-surface, #fff);
    border-bottom: 0.0625rem solid var(--veylique-color-border, rgba(36, 31, 26, 0.14));
  }
  .veylique-pdp-sizeguide-title {
    margin: 0;
    font-family: var(--veylique-font-heading, serif);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .veylique-pdp-sizeguide-close { position: static; }
  .veylique-pdp-sizeguide-body {
    padding: 1.25rem 1.5rem 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .veylique-pdp-sizeguide-body table {
    width: 100%;
    border-collapse: collapse;
  }
  .veylique-pdp-sizeguide-body td,
  .veylique-pdp-sizeguide-body th {
    padding: 0.5rem 0.75rem;
    border: 0.0625rem solid var(--veylique-color-border, rgba(36, 31, 26, 0.14));
    text-align: left;
  }

  /* Toast */
  .veylique-pdp-toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    z-index: var(--veylique-z-overlay, 80);
    transform: translate(-50%, 1.5rem);
    max-width: min(24rem, calc(100vw - 2rem));
    padding: 0.875rem 1.25rem;
    border-radius: var(--veylique-radius-sm, 0.5rem);
    background: var(--veylique-color-foreground, #241f1a);
    color: var(--veylique-color-surface, #fff);
    font-size: 0.875rem;
    box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.18);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s var(--veylique-ease-standard, ease);
  }
  .veylique-pdp-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }
  .veylique-pdp-toast a { color: inherit; text-decoration: underline; }

  @media (min-width: 1000px) {
    .veylique-pdp-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: start;
    }
    .veylique-pdp-info {
      position: sticky;
      top: 6rem;
      padding-top: 0.5rem;
    }
    .veylique-pdp-gallery {
      grid-template-columns: 4.25rem minmax(0, 1fr);
    }
    .veylique-pdp-rail {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      scrollbar-width: none;
    }
    .veylique-pdp-rail::-webkit-scrollbar { display: none; }
    .veylique-pdp-dots { display: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function initProduct(section) {
      if (section.dataset.veyliqueProductReady === 'true') return;
      section.dataset.veyliqueProductReady = 'true';

      var dataEl = section.querySelector('[data-pdp-variants]');
      var configEl = section.querySelector('[data-pdp-config]');
      var form = section.querySelector('.veylique-pdp-form');
      if (!dataEl || !form) return;

      var variants, config;
      try {
        variants = JSON.parse(dataEl.textContent);
        config = configEl ? JSON.parse(configEl.textContent) : { strings: {}, cartUrl: '/cart' };
      } catch (e) { return; }

      var idInput = form.querySelector('[data-pdp-variant-id]');
      var atc = form.querySelector('[data-pdp-atc]');
      var atcText = form.querySelector('[data-pdp-atc-text]');
      var priceCurrent = section.querySelector('[data-pdp-price-current]');
      var priceCompare = section.querySelector('[data-pdp-price-compare]');
      var priceSave = section.querySelector('[data-pdp-price-save]');
      var skuEl = section.querySelector('[data-pdp-sku]');
      var swatches = Array.prototype.slice.call(section.querySelectorAll('[data-pdp-swatch]'));
      var toast = section.querySelector('[data-pdp-toast]');
      var stockEl = section.querySelector('[data-pdp-stock]');
      var stockText = section.querySelector('[data-pdp-stock-text]');

      var track = section.querySelector('[data-pdp-track]');
      var slides = Array.prototype.slice.call(section.querySelectorAll('[data-pdp-slide]'));
      var thumbs = Array.prototype.slice.call(section.querySelectorAll('[data-pdp-thumb]'));
      var dots = Array.prototype.slice.call(section.querySelectorAll('[data-pdp-dot]'));
      var counter = section.querySelector('[data-pdp-counter]');

      var s = config.strings || {};
      var strings = {
        add: (atcText && atcText.textContent.trim()) || 'Add to cart',
        soldOut: s.soldOut || 'Sold out',
        unavailable: s.unavailable || 'Unavailable',
        adding: s.adding || 'Adding…',
        added: s.added || 'Added to cart',
        viewCart: s.viewCart || 'View cart',
        error: s.error || 'Please try again.',
        inStock: s.inStock || 'In stock',
        onlyLeft: s.onlyLeft || 'Only [COUNT] left',
        shareCopied: s.shareCopied || 'Link copied'
      };
      var cartUrl = config.cartUrl || '/cart';
      var lowStock = parseInt(config.lowStockThreshold, 10) || 0;
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---------- Gallery ---------- */
      var activeIndex = 0;

      function goToSlide(index, smooth) {
        if (!track || !slides.length) return;
        index = Math.max(0, Math.min(index, slides.length - 1));
        var slide = slides[index];
        track.scrollTo({
          left: slide.offsetLeft,
          behavior: smooth === false || reducedMotion ? 'auto' : 'smooth'
        });
      }

      function setActive(index) {
        activeIndex = index;
        thumbs.forEach(function (t) { t.classList.toggle('is-active', parseInt(t.dataset.index, 10) === index); });
        dots.forEach(function (d) { d.classList.toggle('is-active', parseInt(d.dataset.index, 10) === index); });
        if (counter) counter.textContent = (index + 1) + ' / ' + slides.length;
        var activeThumb = thumbs[index];
        if (activeThumb && activeThumb.scrollIntoView) {
          activeThumb.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reducedMotion ? 'auto' : 'smooth' });
        }
      }

      if (track && slides.length > 1 && 'IntersectionObserver' in window) {
        var slideObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.55) {
              setActive(parseInt(entry.target.dataset.index, 10));
            }
          });
        }, { root: track, threshold: 0.55 });
        slides.forEach(function (slide) { slideObserver.observe(slide); });
      }

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () { goToSlide(parseInt(thumb.dataset.index, 10)); });
      });

      var prevBtn = section.querySelector('[data-pdp-prev]');
      var nextBtn = section.querySelector('[data-pdp-next]');
      if (prevBtn) prevBtn.addEventListener('click', function () { goToSlide(activeIndex - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { goToSlide(activeIndex + 1); });

      if (track) {
        track.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowLeft') { event.preventDefault(); goToSlide(activeIndex - 1); }
          if (event.key === 'ArrowRight') { event.preventDefault(); goToSlide(activeIndex + 1); }
        });
      }

      /* ---------- Lightbox ---------- */
      var lightbox = section.querySelector('[data-pdp-lightbox]');
      var lightboxImg = section.querySelector('[data-pdp-lightbox-img]');
      var zoomButtons = Array.prototype.slice.call(section.querySelectorAll('[data-pdp-zoom]'));
      var zoomSources = zoomButtons.map(function (b) { return b.dataset.zoomSrc; });
      var lightboxIndex = 0;

      function openLightbox(index) {
        if (!lightbox || !lightboxImg || typeof lightbox.showModal !== 'function' || !zoomSources.length) return;
        lightboxIndex = Math.max(0, Math.min(index, zoomSources.length - 1));
        lightboxImg.src = zoomSources[lightboxIndex];
        lightbox.showModal();
      }
      function lightboxStep(delta) {
        if (!zoomSources.length) return;
        lightboxIndex = (lightboxIndex + delta + zoomSources.length) % zoomSources.length;
        lightboxImg.src = zoomSources[lightboxIndex];
      }

      zoomButtons.forEach(function (btn, i) {
        btn.addEventListener('click', function () { openLightbox(i); });
      });
      var lbClose = section.querySelector('[data-pdp-lightbox-close]');
      var lbPrev = section.querySelector('[data-pdp-lightbox-prev]');
      var lbNext = section.querySelector('[data-pdp-lightbox-next]');
      if (lbClose) lbClose.addEventListener('click', function () { lightbox.close(); });
      if (lbPrev) lbPrev.addEventListener('click', function () { lightboxStep(-1); });
      if (lbNext) lbNext.addEventListener('click', function () { lightboxStep(1); });
      if (lightbox) {
        lightbox.addEventListener('click', function (event) {
          if (event.target === lightbox) lightbox.close();
        });
        lightbox.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowLeft') lightboxStep(-1);
          if (event.key === 'ArrowRight') lightboxStep(1);
        });
      }

      /* ---------- Size guide ---------- */
      var sizeGuide = section.querySelector('[data-pdp-sizeguide]');
      section.querySelectorAll('[data-pdp-sizeguide-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (sizeGuide && typeof sizeGuide.showModal === 'function') sizeGuide.showModal();
        });
      });
      var sgClose = section.querySelector('[data-pdp-sizeguide-close]');
      if (sgClose) sgClose.addEventListener('click', function () { sizeGuide.close(); });
      if (sizeGuide) {
        sizeGuide.addEventListener('click', function (event) {
          if (event.target === sizeGuide) sizeGuide.close();
        });
      }

      /* ---------- Variant logic ---------- */
      function selectedOptions() {
        var checked = section.querySelectorAll('[data-pdp-swatch]:checked');
        var opts = [];
        Array.prototype.slice.call(checked).forEach(function (input) {
          opts[parseInt(input.dataset.optionPosition, 10) - 1] = input.value;
        });
        return opts;
      }

      function matchVariant(opts) {
        if (!opts.length) return variants[0];
        return variants.find(function (v) {
          return v.options.every(function (opt, i) { return opts[i] === opt; });
        });
      }

      function updateSelectedLabels() {
        section.querySelectorAll('[data-pdp-option-selected]').forEach(function (el) {
          var pos = el.getAttribute('data-pdp-option-selected');
          var checked = section.querySelector('[data-pdp-swatch][data-option-position="' + pos + '"]:checked');
          if (checked) el.textContent = checked.value;
        });
      }

      function updateAvailability() {
        var current = selectedOptions();
        swatches.forEach(function (input) {
          var pos = parseInt(input.dataset.optionPosition, 10) - 1;
          var probe = current.slice();
          probe[pos] = input.value;
          var match = variants.find(function (v) {
            return v.options.every(function (opt, i) {
              if (i === pos) return opt === input.value;
              return probe[i] == null || probe[i] === opt;
            });
          });
          var anyAvailable = variants.some(function (v) {
            return v.options[pos] === input.value && v.available;
          });
          if (match && anyAvailable) input.removeAttribute('data-unavailable');
          else input.setAttribute('data-unavailable', '');
        });
      }

      function updateStock(variant) {
        if (!stockEl || !stockText || !lowStock) return;
        if (!variant || !variant.available) { stockEl.hidden = true; return; }
        if (variant.inventory_managed && variant.inventory_policy !== 'continue' && variant.inventory_quantity > 0 && variant.inventory_quantity <= lowStock) {
          stockText.textContent = strings.onlyLeft.replace('[COUNT]', variant.inventory_quantity);
          stockEl.classList.add('is-low');
          stockEl.hidden = false;
        } else {
          stockText.textContent = strings.inStock;
          stockEl.classList.remove('is-low');
          stockEl.hidden = false;
        }
      }

      var stickyPrice = section.querySelector('[data-pdp-sticky-price]');
      var stickyAtcText = section.querySelector('[data-pdp-sticky-atc-text]');

      function setMainImage(variant) {
        if (!variant || variant.featured_media_id == null) return;
        var slide = slides.filter(function (sl) {
          return sl.dataset.mediaId === String(variant.featured_media_id);
        })[0];
        if (slide) goToSlide(parseInt(slide.dataset.index, 10));
      }

      function render() {
        var variant = matchVariant(selectedOptions());
        updateSelectedLabels();
        updateAvailability();

        if (!variant) {
          if (idInput) idInput.value = '';
          if (atc) { atc.disabled = true; }
          if (atcText) atcText.textContent = strings.unavailable;
          if (stickyAtcText) stickyAtcText.textContent = strings.unavailable;
          if (stockEl) stockEl.hidden = true;
          return;
        }

        if (idInput) idInput.value = variant.id;

        if (priceCurrent) {
          priceCurrent.textContent = variant.price;
          priceCurrent.classList.toggle('is-sale', !!variant.compare_at_price);
        }
        if (priceCompare) {
          if (variant.compare_at_price) { priceCompare.textContent = variant.compare_at_price; priceCompare.hidden = false; }
          else { priceCompare.hidden = true; }
        }
        if (priceSave) {
          if (variant.compare_at_price && variant.compare_num > variant.price_num) {
            var pct = Math.round((variant.compare_num - variant.price_num) * 100 / variant.compare_num);
            priceSave.textContent = '-' + pct + '%';
            priceSave.hidden = false;
          } else { priceSave.hidden = true; }
        }
        if (skuEl) {
          if (variant.sku) { skuEl.textContent = 'SKU: ' + variant.sku; skuEl.hidden = false; }
          else { skuEl.hidden = true; }
        }

        if (atc) {
          atc.disabled = !variant.available;
          if (atcText) atcText.textContent = variant.available ? strings.add : strings.soldOut;
        }
        if (stickyPrice) stickyPrice.textContent = variant.price;
        if (stickyAtcText) stickyAtcText.textContent = variant.available ? strings.add : strings.soldOut;

        updateStock(variant);
        setMainImage(variant);

        if (window.history && window.history.replaceState) {
          var url = new URL(window.location.href);
          url.searchParams.set('variant', variant.id);
          window.history.replaceState({}, '', url.toString());
        }
      }

      swatches.forEach(function (input) {
        input.addEventListener('change', render);
      });

      /* ---------- Quantity stepper ---------- */
      var qtyInput = section.querySelector('[data-pdp-qty-input]');
      var qtyDown = section.querySelector('[data-pdp-qty-down]');
      var qtyUp = section.querySelector('[data-pdp-qty-up]');
      function clampQty() {
        var n = parseInt(qtyInput.value, 10);
        if (isNaN(n) || n < 1) n = 1;
        qtyInput.value = n;
        return n;
      }
      if (qtyDown) qtyDown.addEventListener('click', function () { qtyInput.value = Math.max(1, clampQty() - 1); });
      if (qtyUp) qtyUp.addEventListener('click', function () { qtyInput.value = clampQty() + 1; });
      if (qtyInput) qtyInput.addEventListener('change', clampQty);

      /* ---------- Toast ---------- */
      var toastTimer;
      function showToast(html) {
        if (!toast) return;
        toast.innerHTML = html;
        toast.classList.add('is-visible');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(function () { toast.classList.remove('is-visible'); }, 4000);
      }

      function updateCartCount(count) {
        var el = document.querySelector('.veylique-cart-count');
        if (el) { el.textContent = count; return; }
        var trigger = document.querySelector('.veylique-cart-trigger');
        if (trigger && count > 0) {
          var span = document.createElement('span');
          span.className = 'veylique-cart-count';
          span.textContent = count;
          trigger.appendChild(span);
        }
      }

      /* ---------- AJAX add-to-cart ---------- */
      form.addEventListener('submit', function (event) {
        if (!window.fetch) return;
        event.preventDefault();
        if (!idInput || !idInput.value || (atc && atc.disabled)) return;

        atc.classList.add('is-loading');
        if (atcText) atcText.textContent = strings.adding;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: new FormData(form)
        })
          .then(function (r) { if (!r.ok) throw new Error('add'); return r.json(); })
          .then(function () { return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.json(); }); })
          .then(function (cart) {
            updateCartCount(cart.item_count);
            showToast(strings.added + ' &middot; <a href="' + cartUrl + '">' + strings.viewCart + '</a>');
            /* Refresh the drawer but leave it closed — an add should not
               interrupt browsing. The shopper opens it when they choose to. */
            document.dispatchEvent(new CustomEvent('veylique:cart:updated', { detail: { open: false } }));
          })
          .catch(function () { showToast(strings.error); })
          .finally(function () {
            atc.classList.remove('is-loading');
            if (atcText) atcText.textContent = strings.add;
          });
      });

      /* ---------- Sticky mobile bar ---------- */
      var stickyBar = section.querySelector('[data-pdp-sticky]');
      var stickyAtc = section.querySelector('[data-pdp-sticky-atc]');
      var actions = section.querySelector('.veylique-pdp-actions');
      if (stickyBar && actions && 'IntersectionObserver' in window) {
        var barObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
            stickyBar.classList.toggle('is-visible', show);
            stickyBar.setAttribute('aria-hidden', String(!show));
          });
        }, { threshold: 0 });
        barObserver.observe(actions);
      }
      if (stickyAtc) {
        stickyAtc.addEventListener('click', function () {
          if (atc && !atc.disabled) {
            if (typeof form.requestSubmit === 'function') form.requestSubmit(atc);
            else atc.click();
          }
        });
      }

      /* ---------- Share ---------- */
      var shareBtn = section.querySelector('[data-pdp-share]');
      if (shareBtn) {
        shareBtn.addEventListener('click', function () {
          var payload = { title: shareBtn.dataset.shareTitle, url: shareBtn.dataset.shareUrl };
          if (navigator.share) {
            navigator.share(payload).catch(function () {});
          } else if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(payload.url).then(function () { showToast(strings.shareCopied); });
          }
        });
      }

      render();
    }

    function boot() {
      document.querySelectorAll('[data-veylique-product]').forEach(initProduct);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target && e.target.querySelector) {
        var s = e.target.querySelector('[data-veylique-product]');
        if (s) initProduct(s);
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "richtext",
      "id": "details_text",
      "label": "t:sections.product.settings.details_text.label"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "t:sections.product.settings.shipping_text.label"
    },
    {
      "type": "richtext",
      "id": "size_guide_text",
      "label": "t:sections.product.settings.size_guide_text.label",
      "info": "t:sections.product.settings.size_guide_text.info"
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "t:sections.product.settings.low_stock_threshold.label",
      "info": "t:sections.product.settings.low_stock_threshold.info",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "t:sections.product.blocks.trust.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.product.blocks.trust.settings.icon.label",
          "default": "shipping",
          "options": [
            { "value": "shipping", "label": "t:sections.product.blocks.trust.settings.icon.options.shipping" },
            { "value": "returns", "label": "t:sections.product.blocks.trust.settings.icon.options.returns" },
            { "value": "secure", "label": "t:sections.product.blocks.trust.settings.icon.options.secure" },
            { "value": "quality", "label": "t:sections.product.blocks.trust.settings.icon.options.quality" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.product.blocks.trust.settings.text.label",
          "default": "Free shipping over Rs. 2,000"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
