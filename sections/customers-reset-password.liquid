{% comment %}
  Password reset — reached from the recovery email Shopify sends.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/customers-reset-password
{% endcomment %}

<section class="veylique-account veylique-page full-width" aria-labelledby="VeyliqueResetTitle-{{ section.id }}">
  <div class="veylique-container veylique-account__inner">
    <div class="veylique-account__panel">
      <h1 id="VeyliqueResetTitle-{{ section.id }}" class="veylique-account__title">
        {{ 'customers.reset_password.title' | t }}
      </h1>
      <p class="veylique-text veylique-account__lead">{{ 'customers.reset_password.subtext' | t }}</p>

      {% form 'reset_customer_password' %}
        {{ form.errors | default_errors }}

        <div class="veylique-field">
          <label class="veylique-field__label" for="ResetPassword-{{ section.id }}">
            {{ 'customers.reset_password.password' | t }}
          </label>
          <input
            class="veylique-field__input"
            type="password"
            name="customer[password]"
            id="ResetPassword-{{ section.id }}"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="veylique-field">
          <label class="veylique-field__label" for="ResetPasswordConfirm-{{ section.id }}">
            {{ 'customers.reset_password.password_confirm' | t }}
          </label>
          <input
            class="veylique-field__input"
            type="password"
            name="customer[password_confirmation]"
            id="ResetPasswordConfirm-{{ section.id }}"
            autocomplete="new-password"
            required
          >
        </div>

        <button type="submit" class="veylique-button veylique-button--solid veylique-account__submit">
          {{ 'customers.reset_password.submit' | t }}
        </button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.customers-reset-password.name",
  "settings": []
}
{% endschema %}
