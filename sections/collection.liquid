{% comment %}
  Veylique shop / collection page.

  Full-featured product listing used by the collection template (and
  /collections/all). Renders a branded header, a results toolbar with sort and a
  column switcher, storefront filtering (sidebar on desktop, drawer on mobile),
  a responsive product grid built from the reusable `veylique-home-product-card`
  snippet, empty states, and custom pagination.

  Filtering and sorting are CSS-first and fully functional without JavaScript
  (native GET forms). JavaScript only progressively enhances the experience —
  auto-submitting on change, opening the mobile drawer, and switching columns.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{% liquid
  assign per_page = section.settings.products_per_page
  assign cols_d = section.settings.columns_desktop
  assign cols_t = section.settings.columns_tablet
  assign cols_m = section.settings.columns_mobile
  assign enable_filtering = section.settings.enable_filtering
  assign enable_sorting = section.settings.enable_sorting

  assign has_filters = false
  if enable_filtering and collection.filters.size > 0
    assign has_filters = true
  endif

  assign sort_by = collection.sort_by | default: collection.default_sort_by

  assign active_filter_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_filter_count = active_filter_count | plus: 1
      endif
    else
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endif
  endfor
%}

{%- capture collection_heading -%}
  {%- if section.settings.show_breadcrumb -%}
    <nav class="veylique-collection__breadcrumb" aria-label="breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ collection.title | escape }}</span>
    </nav>
  {%- endif -%}
  {%- if section.settings.kicker != blank -%}
    <p class="veylique-kicker">{{ section.settings.kicker | escape }}</p>
  {%- endif -%}
  <h1 id="VeyliqueCollectionTitle-{{ section.id }}" class="veylique-section-title veylique-collection__title">
    {{ collection.title | escape }}
  </h1>
  {%- if section.settings.show_description and collection.description != blank -%}
    <div class="veylique-collection__description veylique-text">{{ collection.description }}</div>
  {%- endif -%}
{%- endcapture -%}

<section
  class="veylique-collection veylique-page full-width"
  data-veylique-collection
  data-section-id="{{ section.id }}"
  data-collection-url="{{ collection.url }}"
  aria-labelledby="VeyliqueCollectionTitle-{{ section.id }}"
>
  {%- if section.settings.show_hero -%}
    {%- liquid
      assign hero_image = collection.image
      if hero_image == blank
        assign hero_image = section.settings.hero_image
      endif
      assign hero_fallback = section.settings.hero_fallback
    -%}
    <noscript>
      <style>
        .veylique-shop-hero-eyebrow,
        .veylique-shop-hero-title,
        .veylique-shop-hero-desc {
          visibility: visible !important;
          animation: none !important;
        }
      </style>
    </noscript>
    <div class="veylique-page veylique-shop-hero veylique-collection__hero" data-veylique-shop-hero>
      <div class="veylique-shop-hero-media">
        {% render 'veylique-responsive-image',
          image: hero_image,
          fallback: hero_fallback,
          class: 'veylique-media',
          alt: collection.title,
          loading: 'eager',
          width: 2400,
          height: 1600
        %}
      </div>
      <div class="veylique-shop-hero-overlay"></div>
      <div class="veylique-shop-hero-inner">
        {%- if section.settings.show_breadcrumb -%}
          <nav class="veylique-collection__breadcrumb" aria-label="breadcrumb">
            <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ collection.title | escape }}</span>
          </nav>
        {%- endif -%}
        {%- if section.settings.kicker != blank -%}
          <p class="veylique-shop-hero-eyebrow">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        <h1 id="VeyliqueCollectionTitle-{{ section.id }}" class="veylique-shop-hero-title">{{ collection.title | escape }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="veylique-collection__hero-text veylique-shop-hero-desc">{{ collection.description }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="veylique-container veylique-collection__body{% unless section.settings.show_hero %} veylique-collection__body--flush{% endunless %}">
    {%- unless section.settings.show_hero -%}
      <header class="veylique-collection__head veylique-collection__head--{{ section.settings.heading_alignment }}">
        {{ collection_heading }}
      </header>
    {%- endunless -%}

    {%- comment -%} Toolbar {%- endcomment -%}
    <div class="veylique-collection__toolbar" data-veylique-toolbar>
      <div class="veylique-collection__toolbar-start">
        {%- if has_filters -%}
          <button
            type="button"
            class="veylique-collection__filter-toggle"
            data-veylique-drawer-open
            aria-expanded="false"
            aria-controls="VeyliqueFacets-{{ section.id }}"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M6 12h12M10 18h4"/></svg>
            <span>{{ 'collection.filters' | t }}</span>
            {%- if active_filter_count > 0 -%}
              <span class="veylique-collection__filter-count">{{ active_filter_count }}</span>
            {%- endif -%}
          </button>
        {%- endif -%}

        {%- if section.settings.show_product_count -%}
          <p class="veylique-collection__count" aria-live="polite">
            {{ 'collection.product_count' | t: count: collection.products_count }}
          </p>
        {%- endif -%}
        <span class="veylique-collection__spinner" aria-hidden="true"></span>
      </div>

      <div class="veylique-collection__toolbar-end">
        {%- if section.settings.enable_column_switcher -%}
          {%- comment -%} Desktop: 2 / 3 / 4 columns {%- endcomment -%}
          <div class="veylique-collection__cols veylique-collection__cols--desktop" role="group" aria-label="{{ 'collection.columns' | t }}">
            <button type="button" class="veylique-collection__cols-btn{% if cols_d == 2 %} is-active{% endif %}" data-veylique-cols="2" data-veylique-cols-scope="d" aria-label="{{ 'collection.columns' | t }}: 2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3.5" y="4" width="7.5" height="16" rx="1"/><rect x="13" y="4" width="7.5" height="16" rx="1"/></svg>
            </button>
            <button type="button" class="veylique-collection__cols-btn{% if cols_d == 3 %} is-active{% endif %}" data-veylique-cols="3" data-veylique-cols-scope="d" aria-label="{{ 'collection.columns' | t }}: 3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="4" width="4.75" height="16" rx="1"/><rect x="9.6" y="4" width="4.75" height="16" rx="1"/><rect x="16.25" y="4" width="4.75" height="16" rx="1"/></svg>
            </button>
            <button type="button" class="veylique-collection__cols-btn{% if cols_d == 4 %} is-active{% endif %}" data-veylique-cols="4" data-veylique-cols-scope="d" aria-label="{{ 'collection.columns' | t }}: 4">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2.5" y="4" width="3.5" height="16" rx="1"/><rect x="7.5" y="4" width="3.5" height="16" rx="1"/><rect x="12.5" y="4" width="3.5" height="16" rx="1"/><rect x="17.5" y="4" width="3.5" height="16" rx="1"/></svg>
            </button>
          </div>

          {%- comment -%}
            Mobile: 1 / 2 columns. Small screens previously had no way to switch
            density at all — one-up is what shoppers reach for to judge fabric
            and fit on a phone.
          {%- endcomment -%}
          <div class="veylique-collection__cols veylique-collection__cols--mobile" role="group" aria-label="{{ 'collection.columns' | t }}">
            {%- comment -%}
              columns_mobile is a select, so its value is the STRING "1"/"2" —
              comparing against a number would silently never match.
            {%- endcomment -%}
            <button type="button" class="veylique-collection__cols-btn{% if cols_m == '1' %} is-active{% endif %}" data-veylique-cols="1" data-veylique-cols-scope="m" aria-label="{{ 'collection.columns' | t }}: 1">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="1"/></svg>
            </button>
            <button type="button" class="veylique-collection__cols-btn{% if cols_m == '2' %} is-active{% endif %}" data-veylique-cols="2" data-veylique-cols-scope="m" aria-label="{{ 'collection.columns' | t }}: 2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3.5" y="4" width="7.5" height="16" rx="1"/><rect x="13" y="4" width="7.5" height="16" rx="1"/></svg>
            </button>
          </div>
        {%- endif -%}

        {%- if enable_sorting -%}
          {%- liquid
            assign sort_label = ''
            for option in collection.sort_options
              if option.value == sort_by
                assign sort_label = option.name
              endif
            endfor
          -%}
          <form method="get" class="veylique-collection__sort" data-veylique-sort-form>
            <label for="VeyliqueSort-{{ section.id }}" class="veylique-collection__sort-label">{{ 'collection.sort_by' | t }}</label>
            <div class="veylique-collection__select">
              <select name="sort_by" id="VeyliqueSort-{{ section.id }}" data-veylique-sort>
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == sort_by %}selected="selected"{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </div>

            <div class="veylique-sort-ui" data-veylique-sort-ui>
              <button
                type="button"
                class="veylique-sort-ui__btn"
                data-veylique-sort-btn
                aria-expanded="false"
                aria-haspopup="listbox"
              >
                <span data-veylique-sort-label>{{ sort_label | escape }}</span>
                <svg class="veylique-sort-ui__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <ul class="veylique-sort-ui__list" role="listbox" aria-label="{{ 'collection.sort_by' | t }}">
                {%- for option in collection.sort_options -%}
                  <li role="presentation">
                    <button
                      type="button"
                      class="veylique-sort-ui__option{% if option.value == sort_by %} is-selected{% endif %}"
                      role="option"
                      aria-selected="{% if option.value == sort_by %}true{% else %}false{% endif %}"
                      data-veylique-sort-option="{{ option.value }}"
                    >
                      {{ option.name }}
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
            {%- comment -%} Preserve active filters when sorting without JS {%- endcomment -%}
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != null -%}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}">{%- endif -%}
                {%- if filter.max_value.value != null -%}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}">{%- endif -%}
              {%- else -%}
                {%- for value in filter.active_values -%}
                  <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
            <noscript><button type="submit" class="veylique-button veylique-button--outline veylique-collection__sort-apply">{{ 'collection.apply' | t }}</button></noscript>
          </form>
        {%- endif -%}
      </div>
    </div>

    <div class="veylique-collection__layout{% unless has_filters %} veylique-collection__layout--full{% endunless %}">
      {%- if has_filters -%}
        <aside
          id="VeyliqueFacets-{{ section.id }}"
          class="veylique-facets{% if section.settings.sticky_sidebar %} veylique-facets--sticky{% endif %}"
          data-veylique-facets
        >
          <div class="veylique-facets__header">
            <span class="veylique-facets__heading">{{ 'collection.filters' | t }}</span>
            <button type="button" class="veylique-facets__close" data-veylique-drawer-close aria-label="{{ 'collection.close' | t }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>

          <form method="get" data-veylique-facet-form class="veylique-facets__form">
            {%- comment -%} Preserve sort when filtering {%- endcomment -%}
            {%- if collection.sort_by != blank -%}
              <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
            {%- endif -%}

            {%- comment -%}
              Ordered passes rather than one loop: shoppers reach for size
              first, then colour, then price. Availability is skipped entirely —
              every variant is stocked, so an in/out of stock control is noise.
            {%- endcomment -%}
            {%- for filter in collection.filters -%}
              {%- liquid
                assign facet_label_down = filter.label | downcase
                assign facet_is_size = false
                if facet_label_down contains 'size'
                  assign facet_is_size = true
                endif
              -%}
              {%- if facet_is_size -%}
                {% render 'veylique-facet', filter: filter, force_open: true %}
              {%- endif -%}
            {%- endfor -%}

            {%- for filter in collection.filters -%}
              {%- liquid
                assign facet_label_down = filter.label | downcase
                assign facet_is_color = false
                if facet_label_down contains 'color' or facet_label_down contains 'colour'
                  assign facet_is_color = true
                endif
              -%}
              {%- if facet_is_color -%}
                {% render 'veylique-facet', filter: filter, force_open: true %}
              {%- endif -%}
            {%- endfor -%}

            {%- for filter in collection.filters -%}
              {%- if filter.type == 'price_range' -%}
                {% render 'veylique-facet', filter: filter, force_open: true %}
              {%- endif -%}
            {%- endfor -%}

            {%- for filter in collection.filters -%}
              {%- liquid
                assign facet_label_down = filter.label | downcase
                assign facet_is_other = true
                if filter.type == 'price_range'
                  assign facet_is_other = false
                endif
                if facet_label_down contains 'size'
                  assign facet_is_other = false
                endif
                if facet_label_down contains 'color' or facet_label_down contains 'colour'
                  assign facet_is_other = false
                endif
                if facet_label_down contains 'availability'
                  assign facet_is_other = false
                endif
                if filter.param_name contains 'availability'
                  assign facet_is_other = false
                endif
              -%}
              {%- if facet_is_other -%}
                {% render 'veylique-facet', filter: filter %}
              {%- endif -%}
            {%- endfor -%}

            <div class="veylique-facets__actions">
              <button type="submit" class="veylique-button veylique-button--solid">{{ 'collection.apply' | t }}</button>
              <a href="{{ collection.url }}" class="veylique-button veylique-button--ghost">{{ 'collection.clear_all' | t }}</a>
            </div>
          </form>
        </aside>

        <div class="veylique-facets__overlay" data-veylique-drawer-close hidden></div>
      {%- endif -%}

      <div class="veylique-collection__results" data-veylique-results>
        {%- if has_filters and active_filter_count > 0 -%}
          <div class="veylique-collection__applied">
            <ul class="veylique-collection__pills" role="list">
              {%- for filter in collection.filters -%}
                {%- if filter.type == 'price_range' -%}
                  {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                    <li>
                      <a class="veylique-collection__pill" href="{{ filter.url_to_remove }}">
                        {%- if filter.min_value.value != null -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}
                        –
                        {%- if filter.max_value.value != null -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                      </a>
                    </li>
                  {%- endif -%}
                {%- else -%}
                  {%- for value in filter.active_values -%}
                    <li>
                      <a class="veylique-collection__pill" href="{{ value.url_to_remove }}" aria-label="{{ 'collection.remove_filter' | t: label: value.label }}">
                        {{ value.label | escape }}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                      </a>
                    </li>
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
            <a href="{{ collection.url }}" class="veylique-collection__clear-all">{{ 'collection.clear_all' | t }}</a>
          </div>
        {%- endif -%}

        {%- paginate collection.products by per_page -%}
          {%- if collection.products.size == 0 -%}
            <div class="veylique-collection__empty">
              {%- if active_filter_count > 0 -%}
                <h2 class="veylique-collection__empty-title">{{ 'collection.no_results_title' | t }}</h2>
                <p class="veylique-text">{{ 'collection.no_results_text' | t }}</p>
                <a href="{{ collection.url }}" class="veylique-button veylique-button--solid">{{ 'collection.clear_all' | t }}</a>
              {%- else -%}
                <h2 class="veylique-collection__empty-title">{{ 'collection.no_products_title' | t }}</h2>
                <p class="veylique-text">{{ 'collection.no_products_text' | t }}</p>
                <a href="{{ routes.all_products_collection_url }}" class="veylique-button veylique-button--solid">{{ 'collection.browse_all' | t }}</a>
              {%- endif -%}
            </div>
          {%- else -%}
            <div
              class="veylique-collection__grid"
              data-veylique-grid
              style="--cols-d: {{ cols_d }}; --cols-t: {{ cols_t }}; --cols-m: {{ cols_m }};"
            >
              {%- for product in collection.products -%}
                <div class="veylique-collection__cell">
                  {% render 'veylique-home-product-card',
                    product: product,
                    show_brand: section.settings.show_vendor,
                    quick_add: section.settings.enable_quick_add
                  %}
                </div>
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <nav class="veylique-pagination" role="navigation" aria-label="{{ 'collection.pagination' | t }}">
                {%- if paginate.previous -%}
                  <a class="veylique-pagination__link veylique-pagination__nav" href="{{ paginate.previous.url }}" aria-label="{{ paginate.previous.title }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                  </a>
                {%- endif -%}

                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a class="veylique-pagination__link" href="{{ part.url }}" aria-label="{{ 'collection.page' | t: number: part.title }}">{{ part.title }}</a>
                  {%- elsif part.title == paginate.current_page -%}
                    <span class="veylique-pagination__link is-current" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span class="veylique-pagination__gap">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}

                {%- if paginate.next -%}
                  <a class="veylique-pagination__link veylique-pagination__nav" href="{{ paginate.next.url }}" aria-label="{{ paginate.next.title }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                  </a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .veylique-collection {
    --veylique-collection-gap: clamp(0.75rem, 2.4vw, 1.75rem);
    /* Matches the fixed site header so sticky UI parks just below it. */
    --veylique-collection-header-h: 4.5rem;
  }
  @media (max-width: 640px) {
    .veylique-collection { --veylique-collection-header-h: 4.25rem; }
  }

  /* Hero — reuses the shared .veylique-shop-hero banner (same as page hero) */
  .veylique-collection__hero .veylique-collection__breadcrumb {
    margin-bottom: 0.75rem;
    color: rgba(255, 255, 255, 0.78);
  }
  .veylique-collection__hero .veylique-collection__breadcrumb a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
  }
  .veylique-collection__hero .veylique-collection__breadcrumb a:hover { color: #fff; }
  .veylique-collection__hero-text > *:first-child { margin-top: 0; }
  .veylique-collection__hero-text > *:last-child { margin-bottom: 0; }

  /* Body below the hero */
  .veylique-collection__body {
    padding-top: clamp(2rem, 4vw, 3.25rem);
    padding-bottom: var(--veylique-section-spacing);
  }
  .veylique-collection__body--flush {
    padding-top: clamp(7rem, 11vw, 10rem);
  }

  /* Header */
  .veylique-collection__head {
    max-width: 52rem;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }
  .veylique-collection__head--center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .veylique-collection__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--veylique-color-muted);
    font-family: var(--veylique-font-body);
    font-size: 0.8125rem;
  }
  .veylique-collection__head--center .veylique-collection__breadcrumb {
    justify-content: center;
  }
  .veylique-collection__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  .veylique-collection__breadcrumb a:hover {
    color: var(--veylique-color-foreground);
  }

  .veylique-collection__title {
    margin: 0;
  }
  .veylique-collection__description {
    margin-top: 1rem;
  }
  .veylique-collection__description > *:first-child { margin-top: 0; }
  .veylique-collection__description > *:last-child { margin-bottom: 0; }

  /* Toolbar — sticks under the site header so filter + sort stay reachable
     through a long grid, which is the whole point of the control bar. */
  .veylique-collection__toolbar {
    position: sticky;
    top: calc(var(--veylique-collection-header-h) - 0.0625rem);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.875rem 0;
    border-top: var(--veylique-border-width) solid var(--veylique-color-border);
    border-bottom: var(--veylique-border-width) solid var(--veylique-color-border);
    background: var(--veylique-color-background);
    /* Bleed the background to the viewport edges so content scrolling under
       the bar is never visible in the container gutters. */
    box-shadow: -100vw 0 0 var(--veylique-color-background), 100vw 0 0 var(--veylique-color-background);
  }
  .veylique-collection__toolbar-start,
  .veylique-collection__toolbar-end {
    display: flex;
    align-items: center;
    gap: clamp(0.625rem, 2vw, 1.25rem);
  }

  /* Phone: two full-width rows — meta above, controls below — instead of four
     controls fighting over ~360px. */
  @media (max-width: 749.98px) {
    .veylique-collection__toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 0.625rem;
    }
    .veylique-collection__toolbar-start,
    .veylique-collection__toolbar-end {
      justify-content: space-between;
      gap: 0.625rem;
    }
    .veylique-collection__toolbar-end .veylique-collection__sort { flex: 1 1 auto; }
    .veylique-collection__toolbar-end .veylique-collection__select { flex: 1 1 auto; }
    .veylique-collection__toolbar-end .veylique-collection__select select { width: 100%; }
  }

  .veylique-collection__filter-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.55rem 1.125rem;
    border: var(--veylique-border-width) solid var(--veylique-color-border);
    border-radius: var(--veylique-radius-pill);
    background: transparent;
    color: var(--veylique-color-foreground);
    font-family: var(--veylique-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color var(--veylique-duration-fast) ease, background-color var(--veylique-duration-fast) ease;
  }
  .veylique-collection__filter-toggle:hover {
    border-color: var(--veylique-color-foreground);
  }
  .veylique-collection__filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.375rem;
    border-radius: var(--veylique-radius-pill);
    background: var(--veylique-color-foreground);
    color: var(--veylique-color-background);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .veylique-collection__count {
    margin: 0;
    color: var(--veylique-color-muted);
    font-family: var(--veylique-font-body);
    font-size: 0.8125rem;
  }

  .veylique-collection__cols {
    display: none;
    align-items: center;
    gap: 0.125rem;
    padding: 0.1875rem;
    border: var(--veylique-border-width) solid var(--veylique-color-border);
    border-radius: var(--veylique-radius-sm);
  }
  .veylique-collection__cols-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.375rem;
    height: 2.375rem;
    padding: 0;
    border: 0;
    border-radius: calc(var(--veylique-radius-sm) - 0.1875rem);
    background: transparent;
    color: var(--veylique-color-muted);
    cursor: pointer;
    transition: color var(--veylique-duration-fast) ease, background-color var(--veylique-duration-fast) ease;
  }
  .veylique-collection__cols-btn svg { display: block; }
  .veylique-collection__cols-btn:hover { color: var(--veylique-color-foreground); }
  .veylique-collection__cols-btn.is-active {
    color: var(--veylique-color-foreground);
    background: var(--veylique-color-surface-alt);
  }

  .veylique-collection__sort {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .veylique-collection__sort-label {
    margin: 0;
    color: var(--veylique-color-muted);
    font-family: var(--veylique-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .veylique-collection__select {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .veylique-collection__select select {
    appearance: none;
    -webkit-appearance: none;
    min-height: 2.75rem;
    padding: 0.5rem 2rem 0.5rem 0.875rem;
    border: var(--veylique-border-width) solid var(--veylique-color-border);
    border-radius: var(--veylique-radius-sm);
    background: transparent;
    color: var(--veylique-color-foreground);
    font-family: var(--veylique-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  .veylique-collection__select svg {
    position: absolute;
    right: 0.625rem;
    pointer-events: none;
    color: var(--veylique-color-muted);
  }
  .veylique-collection__sort-apply { margin-left: 0.5rem; }

  /* Custom sort dropdown — desktop, JS-enhanced. The native select stays for
     mobile and no-JS. */
  .veylique-sort-ui { display: none; }
  @media (min-width: 990px) {
    .veylique-collection__sort.has-custom .veylique-collection__select { display: none; }
    .veylique-collection__sort.has-custom .veylique-sort-ui {
      display: block;
      position: relative;
    }
  }
  .veylique-sort-ui__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 13rem;
    justify-content: space-between;
    padding: 0.55rem 0.875rem;
    border: var(--veylique-border-width) solid var(--veylique-color-border);
    border-radius: var(--veylique-radius-sm);
    background: transparent;
    color: var(--veylique-color-foreground);
    font-family: var(--veylique-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--veylique-duration-fast) ease;
  }
  .veylique-sort-ui__btn:hover { border-color: var(--veylique-color-foreground); }
  .veylique-sort-ui__chevron {
    color: var(--veylique-color-muted);
    transition: transform var(--veylique-duration-base) var(--veylique-ease-standard);
  }
  .veylique-sort-ui.is-open .veylique-sort-ui__chevron { transform: rotate(180deg); }
  .veylique-sort-ui.is-open .veylique-sort-ui__btn { border-color: var(--veylique-color-foreground); }

  .veylique-sort-ui__list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.375rem);
    z-index: 30;
    display: none;
    min-width: 100%;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    background: var(--veylique-color-surface, #fff);
    border: var(--veylique-border-width) solid var(--veylique-color-border);
    border-radius: 0.75rem;
    box-shadow: 0 1rem 2.5rem rgba(36, 31, 26, 0.14);
  }
  .veylique-sort-ui.is-open .veylique-sort-ui__list { display: block; }

  .veylique-sort-ui__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--veylique-color-foreground);
    font-family: var(--veylique-font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--veylique-duration-fast) ease;
  }
  .veylique-sort-ui__option svg { opacity: 0; flex: 0 0 auto; }
  .veylique-sort-ui__option:hover,
  .veylique-sort-ui__option:focus-visible {
    background: var(--veylique-color-surface-alt);
    outline: none;
  }
  .veylique-sort-ui__option.is-selected {
    background: var(--veylique-color-foreground);
    color: var(--veylique-color-background);
    font-weight: 600;
  }
  .veylique-sort-ui__option.is-selected svg { opacity: 1; }

  /* Layout: sidebar + results */
  .veylique-collection__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 990px) {
    .veylique-collection__layout {
      grid-template-columns: 17rem minmax(0, 1fr);
    }
    .veylique-collection__layout--full {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Product grid */
  .veylique-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols-m, 2), minmax(0, 1fr));
    gap: var(--veylique-collection-gap);
    row-gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 750px) {
    .veylique-collection__grid {
      grid-template-columns: repeat(var(--cols-t, 3), minmax(0, 1fr));
    }
  }
  @media (min-width: 990px) {
    .veylique-collection__grid {
      grid-template-columns: repeat(var(--cols-d, 4), minmax(0, 1fr));
    }
  }
  .veylique-collection__cell { min-width: 0; }

  /* Facets sidebar */
  .veylique-facets__overlay {
    position: fixed;
    inset: 0;
    /* Above the fixed site header (z-index 900) — otherwise the drawer and its
       scrim slide underneath it and the close button is unreachable. */
    z-index: 950;
    background: rgba(29, 25, 21, 0.5);
    opacity: 0;
    transition: opacity var(--veylique-duration-base) ease;
  }
  .veylique-facets__overlay.is-open {
    opacity: 1;
  }

  .veylique-facets__header {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: var(--veylique-border-width) solid var(--veylique-color-border);
  }
  .veylique-facets__heading {
    font-family: var(--veylique-font-heading);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .veylique-facets__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    /* Optical alignment: pull the icon back out to the drawer's padding edge. */
    margin-right: -0.625rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--veylique-color-foreground);
    cursor: pointer;
    transition: background-color var(--veylique-duration-fast) ease;
  }
  .veylique-facets__close:hover { background: var(--veylique-color-surface-alt); }

  .veylique-facets--sticky {
    align-self: start;
  }
  @media (min-width: 990px) {
    .veylique-facets--sticky {
      position: sticky;
      /* Parks below the fixed header AND the sticky toolbar, so the sidebar
         never slides underneath either. */
      top: calc(var(--veylique-collection-header-h) + 5.5rem);
      max-height: calc(100dvh - var(--veylique-collection-header-h) - 7rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      /* `overflow-y: auto` clips on BOTH axes, so anything drawn outside the
         content box is cut off — focus rings, the swatch selection ring and
         hover scale all sit hard against the left edge. Padding on both sides
         (cancelled by equal negative margins) gives them room to paint without
         shifting the sidebar or misaligning the divider lines. */
      padding-inline: 0.5rem;
      margin-inline: -0.5rem;
    }
    /* Thin, unobtrusive scrollbar for the sidebar. */
    .veylique-facets--sticky {
      scrollbar-width: thin;
      scrollbar-color: var(--veylique-color-border) transparent;
    }
    .veylique-facets--sticky::-webkit-scrollbar { width: 0.375rem; }
    .veylique-facets--sticky::-webkit-scrollbar-thumb {
      border-radius: var(--veylique-radius-pill);
      background: var(--veylique-color-border);
    }
  }

  /* Applied filter bar (above the grid) */
  .veylique-collection__applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1.25rem;
  }
  .veylique-collection__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .veylique-collection__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--veylique-radius-pill);
    background: var(--veylique-color-surface-alt);
    color: var(--veylique-color-foreground);
    font-family: var(--veylique-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--veylique-duration-fast) ease;
  }
  .veylique-collection__pill:hover { background: #efe6d5; }
  .veylique-collection__pill svg { opacity: 0.6; }
  .veylique-collection__clear-all {
    color: var(--veylique-color-rose);
    text-decoration: none;
    font-family: var(--veylique-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .veylique-collection__clear-all:hover { text-decoration: underline; }

  /* Colour swatches — a wrapping row of dots. Reading a colour is instant;
     reading a list of colour names inside a scroller is not. */
  .veylique-facet__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .veylique-swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 2.75rem tap target around a 1.75rem dot. */
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
  }
  /* The colour name stays for screen readers and hover tooltips only. */
  .veylique-swatch__name {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .veylique-swatch.is-disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .veylique-swatch input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .veylique-swatch__dot {
    display: inline-block;
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 var(--veylique-border-width) var(--veylique-color-border);
    transition: box-shadow var(--veylique-duration-fast) ease, transform var(--veylique-duration-fast) ease;
  }
  .veylique-swatch input:checked ~ .veylique-swatch__dot {
    box-shadow: 0 0 0 0.125rem var(--veylique-color-background), 0 0 0 0.25rem var(--veylique-color-foreground);
  }
  .veylique-swatch input:focus-visible ~ .veylique-swatch__dot {
    outline: var(--veylique-focus-ring-width) solid var(--veylique-focus-ring-color);
    outline-offset: var(--veylique-focus-ring-offset);
  }
  @media (hover: hover) {
    .veylique-swatch:not(.is-disabled):hover .veylique-swatch__dot { transform: scale(1.08); }
  }

  .veylique-facet {
    border-bottom: var(--veylique-border-width) solid var(--veylique-color-border);
  }
  .veylique-facet:first-of-type {
    border-top: var(--veylique-border-width) solid var(--veylique-color-border);
  }
  .veylique-facet__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--veylique-font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--veylique-color-foreground);
  }
  .veylique-facet__summary::-webkit-details-marker { display: none; }
  .veylique-facet__chevron {
    color: var(--veylique-color-muted);
    transition: transform var(--veylique-duration-base) var(--veylique-ease-standard);
  }
  .veylique-facet[open] .veylique-facet__chevron { transform: rotate(180deg); }
  .veylique-facet__body { padding-bottom: 1.25rem; }

  .veylique-facet__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 15rem;
    overflow-y: auto;
    /* Same reason as the sidebar: this scroller would otherwise clip the
       checkbox focus ring, which sits flush against the left edge. */
    margin: 0 -0.375rem;
    padding: 0 0.375rem;
    list-style: none;
  }
  .veylique-facet__option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    cursor: pointer;
    font-family: var(--veylique-font-body);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--veylique-color-foreground);
  }
  .veylique-facet__option.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .veylique-facet__option input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .veylique-facet__checkbox {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 1.15rem;
    height: 1.15rem;
    border: var(--veylique-border-width) solid var(--veylique-color-border);
    border-radius: var(--veylique-radius-xs);
    color: transparent;
    transition: background-color var(--veylique-duration-fast) ease, border-color var(--veylique-duration-fast) ease, color var(--veylique-duration-fast) ease;
  }
  .veylique-facet__option input:checked ~ .veylique-facet__checkbox {
    background: var(--veylique-color-foreground);
    border-color: var(--veylique-color-foreground);
    color: var(--veylique-color-background);
  }
  .veylique-facet__option input:focus-visible ~ .veylique-facet__checkbox {
    outline: var(--veylique-focus-ring-width) solid var(--veylique-focus-ring-color);
    outline-offset: var(--veylique-focus-ring-offset);
  }
  .veylique-facet__option-label {
    flex: 1 1 auto;
    min-width: 0;
  }
  .veylique-facet__option-count {
    flex: 0 0 auto;
    color: var(--veylique-color-muted);
    font-size: 0.75rem;
  }

  .veylique-facet__price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .veylique-facet__price-field {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 0;
  }
  .veylique-facet__price-currency {
    position: absolute;
    left: 0.625rem;
    color: var(--veylique-color-muted);
    font-size: 0.8125rem;
    pointer-events: none;
  }
  .veylique-facet__price-field input {
    width: 100%;
    padding: 0.55rem 0.5rem 0.55rem 1.5rem;
    border: var(--veylique-border-width) solid var(--veylique-color-border);
    border-radius: var(--veylique-radius-sm);
    background: transparent;
    color: var(--veylique-color-foreground);
    font: inherit;
    font-size: 0.8125rem;
  }
  .veylique-facet__price-sep { color: var(--veylique-color-muted); }
  .veylique-facet__price-note {
    margin: 0.75rem 0 0;
    color: var(--veylique-color-muted);
    font-size: 0.75rem;
  }

  .veylique-facets__actions {
    display: none;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .veylique-facets__actions .veylique-button { flex: 1 1 auto; }

  /* Empty state */
  .veylique-collection__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: clamp(3rem, 8vw, 6rem) 1rem;
    text-align: center;
  }
  .veylique-collection__empty-title {
    margin: 0;
    font-family: var(--veylique-font-heading);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 500;
  }
  .veylique-collection__empty .veylique-text { max-width: 32rem; }

  /* Pagination */
  .veylique-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .veylique-pagination__link,
  .veylique-pagination__gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.5rem;
    border-radius: var(--veylique-radius-sm);
    color: var(--veylique-color-foreground);
    font-family: var(--veylique-font-body);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--veylique-duration-fast) ease, color var(--veylique-duration-fast) ease;
  }
  .veylique-pagination__link:hover {
    background: var(--veylique-color-surface-alt);
  }
  .veylique-pagination__link.is-current {
    background: var(--veylique-color-foreground);
    color: var(--veylique-color-background);
  }
  .veylique-pagination__gap {
    color: var(--veylique-color-muted);
    cursor: default;
  }

  /* Mobile drawer for facets */
  @media (max-width: 989.98px) {
    .veylique-collection__cols--desktop { display: none !important; }

    .veylique-facets {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: 951;
      /* Flex column so the option list is the only thing that scrolls, with the
         title and the apply/clear buttons pinned in view. */
      display: flex;
      flex-direction: column;
      width: min(92vw, 26rem);
      height: 100dvh;
      padding: 0;
      background: var(--veylique-color-background);
      overflow: hidden;
      transform: translateX(100%);
      transition: transform var(--veylique-duration-base) var(--veylique-ease-standard);
      box-shadow: -1rem 0 3rem rgba(29, 25, 21, 0.15);
    }
    .veylique-facets.is-open {
      transform: translateX(0);
    }
    .veylique-facets__header {
      display: flex;
      flex: 0 0 auto;
      padding: 1rem 1.25rem;
      margin-bottom: 0;
    }
    .veylique-facets__form {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      min-height: 0;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
      padding: 0 1.25rem;
    }
    .veylique-facets__actions {
      display: flex;
      position: sticky;
      bottom: 0;
      margin-top: auto;
      /* Clears the iOS home indicator. */
      padding: 1rem 0 calc(1rem + env(safe-area-inset-bottom));
      background: var(--veylique-color-background);
      box-shadow: 0 -0.0625rem 0 var(--veylique-color-border);
    }

    /* The drawer already scrolls — a second scroller inside it traps the
       gesture, so long option lists run their full height here. */
    .veylique-facet__list {
      max-height: none;
      overflow-y: visible;
    }

    /* Comfortable touch targets throughout the drawer. */
    .veylique-facet__summary { padding: 1.125rem 0; }
    .veylique-facet__option { padding: 0.375rem 0; }
    .veylique-facet__chip-face { min-width: 2.75rem; height: 2.75rem; }
  }

  @media (min-width: 990px) {
    .veylique-collection__filter-toggle { display: none; }
    .veylique-collection__cols--desktop { display: inline-flex; }
    .veylique-collection__cols--mobile { display: none !important; }
    .veylique-facets__overlay { display: none; }
  }

  @media (max-width: 989.98px) {
    .veylique-collection__cols--mobile { display: inline-flex; }
  }

  /* Facet group active-count badge */
  .veylique-facet__summary-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .veylique-facet__active {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.125rem;
    height: 1.125rem;
    padding: 0 0.3125rem;
    border-radius: var(--veylique-radius-pill);
    background: var(--veylique-color-foreground);
    color: var(--veylique-color-background);
    font-size: 0.625rem;
    font-weight: 700;
  }

  /* Dual-thumb price slider */
  .veylique-price-slider {
    position: relative;
    height: 1.5rem;
    margin: 0.25rem 0.5rem 1rem 0.25rem;
  }
  .veylique-price-slider__track {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 0.1875rem;
    transform: translateY(-50%);
    border-radius: var(--veylique-radius-pill);
    background: var(--veylique-color-border);
  }
  .veylique-price-slider__fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: var(--veylique-radius-pill);
    background: var(--veylique-color-foreground);
  }
  .veylique-price-slider__range {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    background: none;
    pointer-events: none;
  }
  .veylique-price-slider__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 1.125rem;
    height: 1.125rem;
    border: 0.125rem solid var(--veylique-color-foreground);
    border-radius: 50%;
    background: var(--veylique-color-background);
    cursor: grab;
    pointer-events: auto;
    transition: transform var(--veylique-duration-fast) ease;
  }
  .veylique-price-slider__range::-moz-range-thumb {
    width: 1.125rem;
    height: 1.125rem;
    border: 0.125rem solid var(--veylique-color-foreground);
    border-radius: 50%;
    background: var(--veylique-color-background);
    cursor: grab;
    pointer-events: auto;
  }
  .veylique-price-slider__range::-webkit-slider-thumb:hover { transform: scale(1.12); }
  .veylique-price-slider__range:active::-webkit-slider-thumb { cursor: grabbing; }

  /* Size chips */
  .veylique-facet__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .veylique-facet__chip {
    display: inline-flex;
    cursor: pointer;
  }
  .veylique-facet__chip.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .veylique-facet__chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .veylique-facet__chip-face {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.75rem;
    border: var(--veylique-border-width) solid var(--veylique-color-border);
    border-radius: var(--veylique-radius-sm);
    background: transparent;
    font-family: var(--veylique-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--veylique-color-foreground);
    transition: border-color var(--veylique-duration-fast) ease, background-color var(--veylique-duration-fast) ease, color var(--veylique-duration-fast) ease;
  }
  @media (hover: hover) {
    .veylique-facet__chip:not(.is-disabled):hover .veylique-facet__chip-face {
      border-color: var(--veylique-color-foreground);
    }
  }
  .veylique-facet__chip input:checked ~ .veylique-facet__chip-face {
    border-color: var(--veylique-color-foreground);
    background: var(--veylique-color-foreground);
    color: var(--veylique-color-background);
  }
  .veylique-facet__chip input:focus-visible ~ .veylique-facet__chip-face {
    outline: var(--veylique-focus-ring-width) solid var(--veylique-focus-ring-color);
    outline-offset: var(--veylique-focus-ring-offset);
  }

  /* Facet option search */
  .veylique-facet__search {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .veylique-facet__search svg {
    position: absolute;
    left: 0.625rem;
    color: var(--veylique-color-muted);
    pointer-events: none;
  }
  .veylique-facet__search input {
    width: 100%;
    padding: 0.5rem 0.625rem 0.5rem 1.875rem;
    border: var(--veylique-border-width) solid var(--veylique-color-border);
    border-radius: var(--veylique-radius-sm);
    background: transparent;
    color: var(--veylique-color-foreground);
    font: inherit;
    font-size: 0.8125rem;
  }
  .veylique-facet__search input:focus {
    outline: none;
    border-color: var(--veylique-color-foreground);
  }

  /* Show more / less for long lists */
  .veylique-facet__list.is-collapsible.is-collapsed li:nth-child(n + 9) {
    display: none;
  }
  .veylique-facet__list.is-searching li { display: none; }
  .veylique-facet__list.is-searching li.is-match { display: block; }
  .veylique-facet__more {
    margin-top: 0.625rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--veylique-color-rose);
    font-family: var(--veylique-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  .veylique-facet__more:hover { text-decoration: underline; }

  /* AJAX loading state — the grid keeps its size so the page never jumps, and a
     progress line runs across the results so the wait is legible on mobile
     where the toolbar spinner may be scrolled out of view. */
  .veylique-collection__results { position: relative; }
  .veylique-collection.is-filtering [data-veylique-grid],
  .veylique-collection.is-filtering .veylique-collection__applied {
    opacity: 0.4;
    pointer-events: none;
    transition: opacity var(--veylique-duration-fast) ease;
  }
  .veylique-collection__results::before {
    content: "";
    position: absolute;
    top: -0.5rem;
    left: 0;
    right: 0;
    height: 0.125rem;
    z-index: 5;
    border-radius: var(--veylique-radius-pill);
    background: linear-gradient(
      90deg,
      transparent,
      var(--veylique-color-foreground),
      transparent
    );
    opacity: 0;
    transition: opacity var(--veylique-duration-fast) ease;
    pointer-events: none;
  }
  .veylique-collection.is-filtering .veylique-collection__results::before {
    opacity: 1;
    animation: veylique-collection-sweep 1.1s var(--veylique-ease-standard) infinite;
  }
  @keyframes veylique-collection-sweep {
    0% { transform: translateX(-100%) scaleX(0.4); }
    100% { transform: translateX(100%) scaleX(0.4); }
  }
  .veylique-collection__spinner {
    display: none;
    width: 1.125rem;
    height: 1.125rem;
    border: 0.125rem solid var(--veylique-color-border);
    border-top-color: var(--veylique-color-foreground);
    border-radius: 50%;
    animation: veylique-collection-spin 0.7s linear infinite;
  }
  .veylique-collection.is-filtering .veylique-collection__spinner { display: inline-block; }
  @keyframes veylique-collection-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .veylique-facets,
    .veylique-facets__overlay,
    .veylique-facet__chevron {
      transition: none;
    }
    .veylique-collection__spinner { animation-duration: 1.5s; }
    .veylique-collection.is-filtering .veylique-collection__results::before {
      animation: none;
    }
  }

  /* Very small phones: the grid gets its own breathing room and the size chips
     stop wrapping into ragged rows. */
  @media (max-width: 400px) {
    .veylique-collection__grid { row-gap: 1.75rem; }
    .veylique-collection__filter-toggle,
    .veylique-collection__select select { font-size: 0.75rem; }
    .veylique-collection__count { font-size: 0.75rem; }
  }

  /* Large desktops: let the grid breathe rather than stretching cards. */
  @media (min-width: 1600px) {
    .veylique-collection__layout {
      grid-template-columns: 19rem minmax(0, 1fr);
    }
    .veylique-collection__layout--full {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function initCollection(root) {
      var sections = root.querySelectorAll('[data-veylique-collection]');
      sections.forEach(function (section) {
        if (section.dataset.veyliqueCollectionReady === 'true') return;
        section.dataset.veyliqueCollectionReady = 'true';

        var sectionId = section.dataset.sectionId;
        var priceTimer = null;

        function q(sel) { return section.querySelector(sel); }

        /* ---------- Drawer ---------- */
        var lastFocused = null;
        var FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';

        function drawerIsOpen() {
          var facets = q('[data-veylique-facets]');
          return !!facets && facets.classList.contains('is-open');
        }

        function openDrawer() {
          var facets = q('[data-veylique-facets]');
          var overlay = q('.veylique-facets__overlay');
          var openBtn = q('[data-veylique-drawer-open]');
          if (!facets) return;
          lastFocused = document.activeElement;
          facets.classList.add('is-open');
          if (overlay) {
            overlay.hidden = false;
            requestAnimationFrame(function () { overlay.classList.add('is-open'); });
          }
          if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';

          /* Move focus into the panel so keyboard and screen-reader users land
             inside it rather than continuing through the page behind. */
          var closeBtn = facets.querySelector('[data-veylique-drawer-close]');
          if (closeBtn) closeBtn.focus();
        }

        function closeDrawer() {
          var facets = q('[data-veylique-facets]');
          var overlay = q('.veylique-facets__overlay');
          var openBtn = q('[data-veylique-drawer-open]');
          if (!facets) return;
          var wasOpen = facets.classList.contains('is-open');
          facets.classList.remove('is-open');
          if (overlay) {
            overlay.classList.remove('is-open');
            var hide = function () { overlay.hidden = true; overlay.removeEventListener('transitionend', hide); };
            overlay.addEventListener('transitionend', hide);
          }
          if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';

          if (wasOpen && lastFocused && typeof lastFocused.focus === 'function') {
            lastFocused.focus();
          }
          lastFocused = null;
        }

        document.addEventListener('keydown', function (event) {
          if (!drawerIsOpen()) return;

          if (event.key === 'Escape') { closeDrawer(); return; }
          if (event.key !== 'Tab') return;

          /* Keep Tab inside the open drawer. */
          var facets = q('[data-veylique-facets]');
          var items = Array.prototype.slice.call(facets.querySelectorAll(FOCUSABLE))
            .filter(function (el) { return el.offsetParent !== null; });
          if (!items.length) return;

          var first = items[0];
          var last = items[items.length - 1];

          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });

        /* ---------- AJAX rendering (Section Rendering API) ---------- */
        function buildUrl(base, params) {
          var clean = [];
          params.forEach(function (value, key) {
            if (value !== '') clean.push(encodeURIComponent(key) + '=' + encodeURIComponent(value));
          });
          return base.split('?')[0] + (clean.length ? '?' + clean.join('&') : '');
        }

        function openFacetIndexes() {
          var open = [];
          section.querySelectorAll('[data-veylique-facet-form] .veylique-facet').forEach(function (d, i) {
            if (d.open) open.push(i);
          });
          return open;
        }

        function restoreFacetIndexes(open) {
          section.querySelectorAll('[data-veylique-facet-form] .veylique-facet').forEach(function (d, i) {
            d.open = open.indexOf(i) !== -1;
          });
        }

        /* Product cards ship with .veylique-reveal-js, which is
           `visibility: hidden` until the GSAP reveal engine plays them. That
           engine only scans the DOM present at page load, so cards injected by
           a filter change stayed hidden forever — the grid looked empty even
           though the server had returned products. Filter results should appear
           at once anyway, so show them outright and mark them handled so the
           engine won't re-hide them later. */
        function revealFreshContent(scope) {
          if (!scope) return;
          scope.querySelectorAll('.veylique-reveal-js').forEach(function (el) {
            el.dataset.veyliqueRevealReady = 'true';
            el.style.visibility = 'visible';
            el.style.opacity = '1';
            el.style.transform = 'none';
            el.classList.add('veylique-clip-done');
          });
        }

        function setBusy(busy) {
          var results = q('[data-veylique-results]');
          if (results) results.setAttribute('aria-busy', busy ? 'true' : 'false');
        }

        function refresh(url, push) {
          if (!window.fetch || !sectionId) { window.location.href = url; return; }
          section.classList.add('is-filtering');
          setBusy(true);
          var openState = openFacetIndexes();
          var fetchUrl = url + (url.indexOf('?') === -1 ? '?' : '&') + 'section_id=' + sectionId;

          fetch(fetchUrl)
            .then(function (r) { if (!r.ok) throw new Error('render'); return r.text(); })
            .then(function (text) {
              var doc = new DOMParser().parseFromString(text, 'text/html');
              var fresh = doc.querySelector('[data-veylique-collection]');
              if (!fresh) throw new Error('parse');

              ['[data-veylique-results]', '[data-veylique-facet-form]', '[data-veylique-toolbar]'].forEach(function (sel) {
                var mine = q(sel);
                var theirs = fresh.querySelector(sel);
                if (mine && theirs) {
                  mine.innerHTML = theirs.innerHTML;
                  revealFreshContent(mine);
                }
              });

              restoreFacetIndexes(openState);
              applySavedCols();
              enhanceSort();
              /* The facet form was replaced wholesale, so the slider's fill and
                 thumb positions are inline styles that no longer exist. Without
                 this the price slider renders as an empty track after any
                 filter change and looks broken. */
              syncAllPriceSliders();

              if (push !== false && window.history && window.history.pushState) {
                window.history.pushState({ veyliqueCollection: true }, '', url);
              }

              var results = q('[data-veylique-results]');
              if (results) {
                var top = results.getBoundingClientRect().top + window.pageYOffset - 120;
                if (window.pageYOffset > top) window.scrollTo({ top: top, behavior: 'auto' });
              }
            })
            .catch(function () { window.location.href = url; })
            .finally(function () {
              section.classList.remove('is-filtering');
              setBusy(false);
            });
        }

        function submitFacets() {
          var form = q('[data-veylique-facet-form]');
          if (!form) return;
          var url = buildUrl(section.dataset.collectionUrl || window.location.pathname, new FormData(form));
          refresh(url);
        }

        window.addEventListener('popstate', function () {
          refresh(window.location.href, false);
        });

        /* ---------- Column switcher ----------
           Desktop and mobile keep independent densities: a shopper who wants
           4-up on a monitor still wants 1- or 2-up on a phone, so each scope
           writes its own custom property and remembers its own choice. */
        var storeKeyBase = 'veylique:cols:' + (section.id || 'collection');
        function storeKeyFor(scope) {
          return scope === 'm' ? storeKeyBase + ':m' : storeKeyBase;
        }

        function applyCols(scope, value) {
          var grid = q('[data-veylique-grid]');
          if (!value) return;
          if (grid) grid.style.setProperty(scope === 'm' ? '--cols-m' : '--cols-d', value);
          section.querySelectorAll('[data-veylique-cols-scope="' + scope + '"]').forEach(function (b) {
            b.classList.toggle('is-active', b.dataset.veyliqueCols === value);
          });
        }

        function applySavedCols() {
          ['d', 'm'].forEach(function (scope) {
            var saved = null;
            try { saved = window.localStorage.getItem(storeKeyFor(scope)); } catch (e) {}
            if (saved) applyCols(scope, saved);
          });
        }
        applySavedCols();

        /* ---------- Custom sort dropdown (desktop) ---------- */
        function enhanceSort() {
          var sortForm = q('[data-veylique-sort-form]');
          if (sortForm) sortForm.classList.add('has-custom');
        }
        enhanceSort();

        function closeSortUI() {
          var ui = q('[data-veylique-sort-ui]');
          var btn = q('[data-veylique-sort-btn]');
          if (ui) ui.classList.remove('is-open');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        }

        document.addEventListener('click', function (event) {
          if (!event.target.closest('[data-veylique-sort-ui]')) closeSortUI();
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') closeSortUI();
        });

        /* ---------- Price slider sync ---------- */
        function syncPriceSlider(slider, commit) {
          var minRange = slider.querySelector('[data-veylique-price-range="min"]');
          var maxRange = slider.querySelector('[data-veylique-price-range="max"]');
          var fill = slider.querySelector('[data-veylique-price-fill]');
          var body = slider.closest('.veylique-facet__body');
          if (!minRange || !maxRange || !body) return;

          var max = parseFloat(slider.dataset.max) || 100;
          var lo = Math.min(parseFloat(minRange.value) || 0, parseFloat(maxRange.value) || max);
          var hi = Math.max(parseFloat(minRange.value) || 0, parseFloat(maxRange.value) || max);

          if (fill) {
            fill.style.left = (lo / max * 100) + '%';
            fill.style.right = (100 - hi / max * 100) + '%';
          }

          /* Whichever thumb the shopper is nearer must sit on top, otherwise the
             two overlapping range inputs make one thumb ungrabbable once they
             meet at either end. */
          var mid = max / 2;
          minRange.style.zIndex = lo > mid ? '4' : '3';
          maxRange.style.zIndex = lo > mid ? '3' : '4';

          var minInput = body.querySelector('[data-veylique-price-input="min"]');
          var maxInput = body.querySelector('[data-veylique-price-input="max"]');
          if (minInput) minInput.value = lo > 0 ? Math.round(lo) : '';
          if (maxInput) maxInput.value = hi < max ? Math.round(hi) : '';

          if (commit) {
            window.clearTimeout(priceTimer);
            priceTimer = window.setTimeout(submitFacets, 350);
          }
        }

        /* Typing in the min/max boxes should move the thumbs too. */
        function syncSliderFromInputs(body) {
          var slider = body.querySelector('[data-veylique-price-slider]');
          if (!slider) return;
          var minRange = slider.querySelector('[data-veylique-price-range="min"]');
          var maxRange = slider.querySelector('[data-veylique-price-range="max"]');
          var minInput = body.querySelector('[data-veylique-price-input="min"]');
          var maxInput = body.querySelector('[data-veylique-price-input="max"]');
          var max = parseFloat(slider.dataset.max) || 100;
          if (minRange && minInput) minRange.value = minInput.value === '' ? 0 : minInput.value;
          if (maxRange && maxInput) maxRange.value = maxInput.value === '' ? max : maxInput.value;
          syncPriceSlider(slider, false);
        }

        function syncAllPriceSliders() {
          section.querySelectorAll('[data-veylique-price-slider]').forEach(function (slider) {
            syncPriceSlider(slider, false);
          });
        }
        syncAllPriceSliders();

        /* ---------- Delegated events ---------- */
        section.addEventListener('click', function (event) {
          if (event.target.closest('[data-veylique-drawer-open]')) { openDrawer(); return; }
          if (event.target.closest('[data-veylique-drawer-close]')) { closeDrawer(); return; }

          var sortBtn = event.target.closest('[data-veylique-sort-btn]');
          if (sortBtn) {
            var ui = sortBtn.closest('[data-veylique-sort-ui]');
            var open = ui.classList.toggle('is-open');
            sortBtn.setAttribute('aria-expanded', String(open));
            return;
          }

          var sortOption = event.target.closest('[data-veylique-sort-option]');
          if (sortOption) {
            var select = q('[data-veylique-sort]');
            closeSortUI();
            if (select && select.value !== sortOption.dataset.veyliqueSortOption) {
              select.value = sortOption.dataset.veyliqueSortOption;
              var sortForm = select.closest('form');
              if (sortForm) {
                var url = buildUrl(section.dataset.collectionUrl || window.location.pathname, new FormData(sortForm));
                refresh(url);
              }
            }
            return;
          }

          var colBtn = event.target.closest('[data-veylique-cols]');
          if (colBtn) {
            var colScope = colBtn.dataset.veyliqueColsScope || 'd';
            applyCols(colScope, colBtn.dataset.veyliqueCols);
            try { window.localStorage.setItem(storeKeyFor(colScope), colBtn.dataset.veyliqueCols); } catch (e) {}
            return;
          }

          var moreBtn = event.target.closest('[data-veylique-facet-more]');
          if (moreBtn) {
            var list = moreBtn.parentElement.querySelector('[data-veylique-facet-list]');
            if (list) {
              var collapsed = list.classList.toggle('is-collapsed');
              moreBtn.textContent = collapsed ? moreBtn.dataset.moreLabel : moreBtn.dataset.lessLabel;
            }
            return;
          }

          /* AJAX for pills, clear-all and pagination */
          var ajaxLink = event.target.closest('.veylique-collection__pill, .veylique-collection__clear-all, .veylique-facets__actions a, .veylique-pagination a');
          if (ajaxLink && ajaxLink.href) {
            event.preventDefault();
            refresh(ajaxLink.href);
            if (ajaxLink.closest('.veylique-facets__actions')) closeDrawer();
            return;
          }
        });

        section.addEventListener('change', function (event) {
          var sort = event.target.closest('[data-veylique-sort]');
          if (sort) {
            var sortForm = sort.closest('form');
            if (sortForm) {
              var url = buildUrl(section.dataset.collectionUrl || window.location.pathname, new FormData(sortForm));
              refresh(url);
            }
            return;
          }

          var slider = event.target.closest('[data-veylique-price-slider]');
          if (slider) { syncPriceSlider(slider, true); return; }

          var facetForm = event.target.closest('[data-veylique-facet-form]');
          if (facetForm) {
            if (event.target.type === 'checkbox') {
              submitFacets();
              return;
            }
            if (event.target.hasAttribute('data-veylique-price-input')) {
              var priceBody = event.target.closest('.veylique-facet__body');
              if (priceBody) syncSliderFromInputs(priceBody);
              window.clearTimeout(priceTimer);
              priceTimer = window.setTimeout(submitFacets, 500);
            }
          }
        });

        section.addEventListener('input', function (event) {
          var slider = event.target.closest('[data-veylique-price-slider]');
          if (slider) { syncPriceSlider(slider, false); return; }

          var search = event.target.closest('[data-veylique-facet-search]');
          if (search) {
            var body = search.closest('.veylique-facet__body');
            var list = body && body.querySelector('[data-veylique-facet-list]');
            if (!list) return;
            var term = search.value.trim().toLowerCase();
            list.classList.toggle('is-searching', term.length > 0);
            if (term.length > 0) {
              list.querySelectorAll('li').forEach(function (li) {
                li.classList.toggle('is-match', (li.dataset.facetText || '').indexOf(term) !== -1);
              });
            }
            var more = body.querySelector('[data-veylique-facet-more]');
            if (more) more.hidden = term.length > 0;
          }
        });

        section.addEventListener('submit', function (event) {
          var form = event.target.closest('[data-veylique-facet-form]');
          if (form && window.fetch && sectionId) {
            event.preventDefault();
            submitFacets();
            closeDrawer();
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initCollection(document); });
    } else {
      initCollection(document);
    }
    document.addEventListener('shopify:section:load', function (event) { initCollection(event.target); });
  })();
{% endjavascript %}

