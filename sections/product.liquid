  .veylique-pdp-track::-webkit-scrollbar { display: none; }
  .veylique-pdp-track:focus-visible {
    outline: var(--veylique-focus-ring-width, 0.125rem) solid var(--veylique-focus-ring-color, currentColor);
    outline-offset: -0.25rem;
